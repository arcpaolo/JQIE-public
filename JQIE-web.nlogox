; -------------- Output / debugging

;; Debug-level printing of messages
to dprint [ .dlev .caller .str ]
  if ( $debug-level >= .dlev ) 
  [ 
    (ifelse 
      .dlev = -1 [ error (word "FATAL ERROR (" .caller "): " .str) ] ; Terminate!
      .dlev = 0 [ print (word "TRACE (" .caller "): " .str) ]
      .dlev = 1 [ print (word "WARNING (" .caller "): " .str) ]
      .dlev = 2 [ print (word "DEBUG (" .caller "): " .str) ]
      .dlev = 3 [ print (word "CHECK (" .caller "): " .str) ]
      .dlev = 4 [ print (word "VERBOSE (" .caller "): " .str) ]
      [ print (word "UNDEFINED DPRINT LEVEL (" .caller "): " .str) ]
      )
  ]

end

;; Debug-level printing of messages to the user as a pop-up
to dmsg [ .dlev .caller .str ]
  if ( $debug-level >= .dlev ) 
  [ 
    (ifelse 
      .dlev = -1 [ user-message (word "ERROR (" .caller "): " .str)
        error (word "ERROR (" .caller "): " .str) ] ; Terminate!
      .dlev = 0 [ user-message (word "TRACE (" .caller "): " .str) ]
      .dlev = 1 [ user-message (word "WARNING (" .caller "): " .str) ]
      .dlev = 2 [ user-message (word "DEBUG (" .caller "): " .str) ]
      .dlev = 3 [ user-message (word "CHECK (" .caller "): " .str) ]
      .dlev = 4 [ user-message (word "VERBOSE (" .caller "): " .str) ]
      [ print (word "UNDEFINED DPRINT LEVEL (" .caller "): " .str) ]
      )
  ]

end


; Pen toggle
to toggle-pen
  set $pen-down? not $pen-down?
  ask employees [ ifelse $pen-down? [ pen-down ] [ pen-up ] ]
end

;; Pretty-print a table
to print-table [ .table ]
  foreach table:keys .table [ k -> print (word k ": " table:get .table k) ]
end


;; Print out the daily activities of a turtle
to print-daily-activities [ .who ]
  clear-output

;  let _employee .who
  let _id (word " " remove "employee " ( word .who ) )
;  let _desc _id
;  set _desc insert-item 2 _id "employee "
;  let _co-name [ my-company-name ] of _employee
  let _i 1

  output-print (word "DAY " ticks ": SAMPLE DAILY ACTIVITIES FOR EMPLOYEE " [ my-number ] of .who " OF COMPANY " [ my-company-name ] of .who ) ; _desc )

  foreach [ daily-activities ] of .who [ _a -> 
    output-print ( word _i ": @" remove _id _a ) 
    set _i _i + 1
  ]  
end


;; Report the ID, day and time of any turtle - used to prepend to some error messages.
to-report who-when
  report (word "Day " ticks " @" clock-time $es-daily-time " (" who "): ")
end



;; Shorten the number of significant digits in displaying a floating-point number
to-report clean-number [ .num .digits ]
  let _mult 10 ^ .digits
  report ( round ( _mult * .num ) ) / _mult
end


;; Create a string from a number with commas in it.
to-report currency [ .type .num ]
  let _str (word round .num ) ; Strip decimals
  let _sign ""
  if ( .num < 0 ) [ ; Strip out the minus sign and add it later
    set _sign "-"
    set _str but-first _str
  ]
  
  let _l (length _str ) - 1
  let _num-commas floor ( _l / 3 )
  
  let _i 0
  repeat _num-commas [
    set _l (length _str )
;    set _str insert-item ( _l - ( 3 * ( _i + 1 ) ) - _i ) _str ","
    set _str insert-item ( _l - 4 * _i - 3 ) _str ","
    set _i _i + 1
  ]
  
  report (word .type _sign _str)
  
end

;; User message for procedure stumps that do nothing
to empty-procedure [ .pname ]
  user-message (word "WARNING: The procedure " .pname " currently does absolutely nothing!")
end


;; -------- Various procedures and reporters to process parameter files and lists

;; Parse individual lines of the specified parameters file
to init-parameters-from-csv [ .type .par-row ]
  
  dprint 3 "init-parameters-from-csv" (word "Parsing csv file for " .type )
  
  let _industry item 0 .par-row ; The first item passed in should be the name of the industry
  
  ; If you the first item is blank or starts with #, it's a comment, skip this line
  if ( (length _industry) = 0 or (item 0 _industry = "#") ) [ stop ]
  
  ; If it's for a different industry, skip it also but make a note of it
  if (_industry != $industry) 
  [
    dprint 3 "init-parameters-from-csv" (word "Found a line for industry " _industry ", but ignoring it." )
    stop
  ]

  ; Now remove the first item from the list (the industry indicator)
  set .par-row but-first .par-row
  
  ; Need different handling based on what type of file it is
  let _key item 0 .par-row ; Pull out the first field, typically the company name
  
  if ( .type = "employees" or .type = "tasks" or .type = "tracked-vars" ) 
  [ ; For some of the csv files, to disambiguate possible duplications, combine the first two fields, separated by a '+' sign
    set _key (word _key "+" item 1 .par-row )
  ]
  
  ; Check carefully whether the global table already contains an item with this key, in which case it will be overwritten
  let _tbl 0
  (ifelse
      .type = "companies" [ set _tbl $#companies ]
      .type = "displays" [ set _tbl $#displays ]
      .type = "employees" [ set _tbl $#employees ]
      .type = "tasks" [ set _tbl $#tasks ]
      .type = "tracked-vars" [ set _tbl $#tracked-vars ]
      [ dprint -1 "init-parameters-from-csv" (word "WEIRD: unrecognized type " .type " passed in." ) ]
    )

    if (table:has-key? _tbl _key)
    [
      dmsg -1 "init-parameters-from-csv" (word "While reading " .type ".csv, a duplicate entry for " _key " was found (" table:get _tbl _key ")" )
    ]
    
  ; Now parse each param based on the field formats table
  let _#param-table table:make
  

  ; Do a bit of sanity check to make sure the input file has the right number of items
  if length .par-row != $num-parsed-params
  [
    dprint -1 "init-parameters-from-csv" (word "Expected " $num-parsed-params " in task parameter file " $param-source " but instead found " length .par-row " (task name is " _key ")")
  ]
    
;  ; Now parse each param based on the field formats table
;  let _#param-table table:make

  let _findex 0
  repeat $num-parsed-params [
    let _par item _findex .par-row ; Pull out the item from the row we just read in
    ; Now we take different actions depending on the format
    let _fld item 0 ( item _findex $par-formats ) ; Pull out the field name
    let _fmt item 1 ( item _findex $par-formats ) ; Pull out the field format
    
    (ifelse 
      _fmt = "number" [
        ; Expecting a numerical value, but let's check
        if (not is-number? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a numerical value for field " _fld " but got " _par)
        ]
        table:put _#param-table _fld _par   
      ]
      
      _fmt = "expression" [
        ; Expecting some sort of expression that can be evaluated - could be a constant (like a c
        if (not is-string? _par and not is-number? _par ) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string or number for field " _fld " but got " _par)
        ]
        table:put _#param-table _fld get-value _par   
      ]

      _fmt = "boolean" [
        ; Expecting a numerical value, but let's check
        if (not is-boolean? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a boolean value for field " _fld " but got " _par)
        ]
        table:put _#param-table _fld _par   
      ]
      
      _fmt = "string" [
        ; Expecting a string, but let's check
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string value for field " _fld " but got " _par)
        ]
        table:put _#param-table _fld _par
      ]

      _fmt = "string-list" [
        ; Expecting a list of strings
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string value for field " _fld " but got " _par)
        ]
        
        set _par string-to-list-of-strings _par " " ; Split the string into a list (use a space as separator)
                
        table:put _#param-table _fld _par
      ]

      _fmt = "var-table" [ ; This takes a string with one or more variable names and returns a table with var name and anomymous reporter for each variable
        ; Expecting a list of variable names
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string value for field " _fld " but got " _par)
        ]
        
        let _vnames string-to-list-of-strings _par " " ; Split the string into a list of variable names, use space as the separator
        let _vreps runresult string-to-list-of-expressions _par ; Split the same string into a list of anon reporters to those variables
        let _tt table:make
;        print (word "XX: just created the table " _tt ", will fill it with " _vnames " and " _vreps ) 
        (foreach _vnames _vreps [ [ n r ] -> table:put _tt n r ] ) ; Create a table with entries of the type { "var" [ -> var ] }
          
        table:put _#param-table _fld _tt

      ]

      ; A varname is a string that refers to a declared variable
      _fmt = "varname" [
        ; Expecting a string, but let's check
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string value for field " _fld " but got " _par)
        ]
        table:put _#param-table _fld _par   
      ]

      ; This takes a string with one or more variable names and returns a list of variables
      _fmt = "var-list" [ 
        ; Expecting a list of variable names
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string value for field " _fld " but got " _par)
        ]
        
        let _vnames string-to-list-of-strings _par " " ; Split the string into a list of variable names using space as separator
        table:put _#param-table _fld _vnames

      ]

      ; This looks for a procedure name
      _fmt = "procedure" [
        ; Do some sanity checking, expecting a procedure name
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string for field " _fld " but got " _par)
        ]
        run (word "table:put _#param-table \"" _fld "\" [ -> " _par " ]")
      ]

      ; This takes a string with one or more procedure names and returns a list with anomymous reporters to each procedure
      _fmt = "proc-list" [ 
        ; Expecting a list of procedure names
        if (not is-string? _par) [
          error (word "ERROR: While reading line " _findex " of " $param-source " expected a string value for field " _fld " but got " _par)
        ]
        
        let _pnames string-to-list-of-strings _par " " ; Split the string into a list of procedure names  using space as separator
        let _preps runresult string-to-list-of-expressions _par ; Split the same string into a list of anon reporters to those procedures
        
        ; Create a list with entries of the type [ "proc" [ -> proc ] ]
        let _plist []
        (foreach _pnames _preps [ [ n r ] -> set _plist lput (list n r ) _plist  ] )
                
        table:put _#param-table _fld _plist

      ]

      ; This expects a time range with the format "reporter par1 par2 [units]" with variable number of params and optional units
      _fmt = "time-range" [
        ; Do some sanity checking.
        if (not is-string? _par ) 
          [ ; Uh-oh, not a string or list, throw an error
            error (word "ERROR: While reading line " _findex " of " $param-source " expected a range procedure for field " _fld " but got " _par)
        ]
        
        let _info extract-range _par true ; This reporter splits the string into a list. If "true" is passed in, it expects to find units as well as range specifiers
        let _procname item 0 _info ; The first item should be the procedure name
        let _params item 1 _info ; Extract the parameter(s)
        let _units item 2 _info ; Extrac the units
        
        ; Note: If the range is "fixed" we only get a parameter (no procedure name) so we simply report that, without an anonymous reporter
        let _anoncmd ifelse-value empty? _procname [ (word "[ -> " _params " ]") ] [ (word "[ -> " _procname " " _params " ]") ]
        run (word "table:put _#param-table \"" _fld "\" (list " _anoncmd " \"" _units "\" ) ")
        
      ]
      
      ; This is expecting a procedure followed by one or more values to be passed, e.g., "random 50 120"
      ( _fmt = "range" or _fmt = "number-range" or _fmt = "num-range" )[
        ; Do some sanity checking.
        if ( not is-string? _par ) and ( not is-number? _par ) 
          [ ; Not a string or a number, throw an error
            error (word "ERROR: While reading line " _findex " of " $param-source " expected a range procedure for field " _fld " but got " _par)
        ]
        ; If we get here it means we are passing a string specifying a range
        let _info ""
        let _params ""
        let _procname ""
        ifelse ( is-number? _par )
        [
          set _params (word _par)
        ]
        [ set _info extract-range _par false ; We split the string. If "false", there should be no units attached
          set _procname item 0 _info ; The first item should be the procedure name
          set _params item 1 _info ; Extract the parameter(s)
        ]
        
        ; Note: If the range is "fixed" we only get a parameter (no procedure name) so we simply report that, without an anonymous reporter
        let _anoncmd ifelse-value empty? _procname [ (word "[ -> " _params " ]") ] [ (word "[ -> " _procname " " _params " ]") ]
        run (word "table:put _#param-table \"" _fld "\" " _anoncmd )
        
      ]

      [ ; Uh-oh, got an invalid format!
        dprint -1 "init-parameters-from-csv" (word "The field " _fld " in the file " $param-source " specifies the undefined format \"" _fmt "\".\nVaild format names are: boolean, string, number, number-range, time-range, expression, procedure" )
      ]
    )
    
    set _findex _findex + 1
  ]

  ; NOTE: in order for this to work there must be a global variable called $#[.type], e.g. $#tasks, $#roles, $#displays
  run (word "table:put $#" .type " _key _#param-table")
  
end


; Create an anonymous reporter based on a range passed in from the csv file or params list
to-report extract-range [ .str .units? ]  
  let _len length .str
  let _fun "" ; Initialize the function name to a blank
  
  if _len = 0 [ 
    dprint 0 "extract-range" (word "Parsing a range, was passed an empty cell. Skipping this one.")
    set _fun "blank" ] 

  let _next-space position " " .str ; Find the first space
  
  ifelse (_next-space = FALSE) ; If there are no spaces, it means there are no parameters
  [
    set _fun .str ; In this case we only get the function name
  ]
  [
    set _fun substring .str 0 _next-space ; Extract the name of the range function
    set .str substring .str ( _next-space + 1 ) ( _len ) ; Remove it from the start of the string
  ]

  (ifelse 
    ( _fun = "exp" or _fun = "exponential" ) [ ; The exponential expects one parameter (mean) and an optional unit character
      let _pars string-to-list .str .units?
      if length _pars != 2 [ error (word "ERROR: exponential requires 1 param [mean] and optional units. You entered: " _pars ) ]
      report (sentence "random-exponential" _pars) ]
    ( _fun = "rnd" or _fun = "rand" or _fun = "random" ) [ ; The random uniform distribution expects 3 parameters: min max and time unit character
;      write (word "XXX Asked to create random range with params " .str )
      let _pars string-to-list .str .units?
;      type (word "... which was parsed into the list " _pars)
      let _lp length _pars ; Check how many params we got
      if ( _lp != 3 and _lp != 2 ) [ dprint -1 "extract-range" (word "ERROR: random requires 2 params [min, max] and optional units indicator. You entered: " _pars ) ]
      let _rndcmd ""
      let _min item 0 _pars
      let _max item 1 _pars
      set _rndcmd (word "random-float " (_max - _min ) " + " _min)
;      print (word " and resulted in the command \"" _rndcmd "\"" )
      
      ; Now depending on whether or not there are units, either return the anonymous procedure alone, or create a list
      ifelse ( .units? ) 
      [ 
        let _units item 2 _pars
        report (list _rndcmd "" _units) ; In this case the middle item is blank because the entire command is in the first item
      ]
      [
        report (list _rndcmd "" "" ) ; In this case we simply return the command
      ]
    ]
    ( _fun = "norm" or _fun = "normal" or _fun = "gaussian" ) [ report (word "Normal with params " .str )  ]
    _fun = "fixed" [ ; Returns a fixed value
      let _pars string-to-list .str .units?
      report (sentence "" _pars ) 
    ]
    is-number? _fun [ ; If a number has been passed in (with no units), just return that.
      ; let _pars string-to-list .str .units?
      report (sentence "" _fun "" ) 
    ]
    _fun = "daily" [ report (word "Daily with params " .str ) ]
    _fun = "weekly" [ report (word "weekly with params " .str ) ]
    _fun = "monthly" [ report (word "Monthly with params " .str ) ]
    ( _fun = "annual" or _fun = "yearly" ) [ report (word "Annual with params " .str ) ]
    _fun = "blank" [ report (list "Blank" 0 0 ) ]
    [ error (word "ERROR: The range type " _fun " is not valid. Use one of exp, rnd, fixed, daily, weekly, monthly or annual (" .str ")" ) ]
    )

end


; This reporter splits a procedure string and returns a list. The last character may represents a time unit (if .units = 1)
to-report string-to-list [ .str .units? ]
  let _len length .str
  let _parlist []
  let _next-space position " " .str
  while [ _next-space != FALSE ]
  [
    let _item read-from-string substring .str 0 ( _next-space ) ; Pull out everything up to (and excluding) the next space
    set _parlist lput _item _parlist
    set .str substring .str ( _next-space + 1 ) ( _len )
    set _len length .str
    set _next-space position " " .str
  ]

  ; Need to do this because there is always one more item than there are spaces. The last item could be the units, if so, format it properly
  ifelse .units? 
  [
    set _parlist lput ( formatted-unit .str ) _parlist 
  ]
  [
    set _parlist lput ( read-from-string .str ) _parlist 
  ]

  report (_parlist)
  
end


; This reporter splits a procedure string and returns a list of strings. 
to-report string-to-list-of-strings [ .str .char ]
  let _len length .str
  let _parlist []
  let _next-space position .char .str
  while [ _next-space != FALSE ]
  [
    let _item substring .str 0 ( _next-space ) ; Pull out everything up to (and excluding) the next space
    set _parlist lput _item _parlist
    set .str substring .str ( _next-space + 1 ) ( _len )
    set _len length .str
    set _next-space position " " .str
  ]

  ; Need to catch the last (or only) one
  set _parlist lput .str _parlist 

  report (_parlist)
  
end


; This reporter splits a procedure string and returns a list of anonymous reporters based on the strings in the list. 
to-report string-to-list-of-expressions [ .str ]
  let _len length .str
  let _parlist "(list "
  let _next-space position " " .str
  while [ _next-space != FALSE ]
  [
    let _item (word "[ -> " substring .str 0 ( _next-space ) " ] "); Pull out everything up to (and excluding) the next space
    set _parlist ( word _parlist _item )
    set .str substring .str ( _next-space + 1 ) ( _len )
    set _len length .str
    set _next-space position " " .str
  ]

  ; Need to catch the last (or only) one
  set _parlist (word _parlist "[ -> " .str " ] )")

  report (_parlist)
  
end


;; print out the evar keys in a way that they can be copied to the widget
to print-tracked-var-names
  print (word "===== Trackable variables =====\nCopy the list below and put them into the corresponding widgets.")
  let _old-breed ""
  foreach table:keys $#tracked-vars [ k -> 
    let _l string-to-list-of-strings k "+"
    let _varname item 0 _l
    let _breed item 1 _l
    let _disp table:get ( table:get $#tracked-vars k ) "displayable?"
    
    if ( _breed != _old-breed ) ; New breed detected - print out a break
    [
      set _old-breed _breed
      print (word "\nThe following tracked variables are for " _breed ":")
    ]
    if _disp [ print (word "\"" _varname "\"") ]
  ]
  user-message (word "The tracked variables for employees and companies have been printed in the command area.\n"
    "Copy each set (including the quotes around each variable) and then paste them into the corresponding choice widgets.")

end


;; Report a color name based on color number
to-report color-name [ .cnum ]
  report ( ifelse-value 
    shade-of? gray .cnum [ "gray" ]
    shade-of? red .cnum [ "red" ]
    shade-of? orange .cnum [ "orange" ]
    shade-of? brown .cnum [ "brown" ]
    shade-of? yellow .cnum [ "yellow" ]
    shade-of? green .cnum [ "green" ]
    shade-of? lime .cnum [ "lime" ]
    shade-of? turquoise .cnum [ "turquoise" ]
    shade-of? cyan .cnum [ "cyan" ]
    shade-of? sky .cnum [ "sky" ]
    shade-of? blue .cnum [ "blue" ]
    shade-of? violet .cnum [ "violet" ]
    shade-of? magenta .cnum [ "magenta" ]
    shade-of? pink .cnum [ "pink" ]
    [ "unknown color" ]
    )
end


; Ask the user to input some values
to manual-parameter-override
  let _var-list table:make
  table:put _var-list "sob" "string"
  table:put _var-list "eob" "string"
  table:put _var-list "job-quality" "number"
  table:put _var-list "markup" "number"
  table:put _var-list "color" "expression"
  
  dialog:user-one-of "Which variable?" table:keys _var-list [_varname -> 
  ;let _varname user-one-of "Which variable?" 
  
  let _c0-var 0
  set _c0-var runresult ( word "[ " _varname " ] of company 0 " )
  let _new-var read-from-string user-input (word "The current value of " _varname " for company 0 is " _c0-var ".\nPlease enter the new value: " )
  run (word "ask company 0 [ set " _varname " " _new-var " ]")
  user-message (word _varname " for company 0 is now set to " _new-var )
  ]
  
end


; Compare tables created from the csv (or list) to make sure parameters are matched
to compare-param-tables
  let _t0 0
  let _t1 0
  let _ignore-keys []
  let _discrepancies? false
  let _msg ""
  let _tables-to-check [ "companies" "employees" "tasks" ] ; This is the list of tables to be checked.
  
  ; To check that values match, for each table we specify a list of fields that can be ignored (e.g., name, color and shape)
  ; This way, if more parameters are added they will automatically be checked.
  
  
  ; NOTE: This is really bad, as it is hard-coded for Fashion1 and Fashion2. Need to rewrite when possible.
  foreach _tables-to-check [ .table ->
    
    (ifelse
      .table = "companies" [
        set _t0 table:get $#companies "Fashion1"
        set _t1 table:get $#companies "Fashion2"

        set _ignore-keys [ "name"	"description"	"shape"	"color"	"size" ]
      ]
      .table = "tasks" [
        set _t0 table:get $#tasks "Fashion1+customer"
        set _t1 table:get $#tasks "Fashion2+customer"
        set _ignore-keys [ "company" "type" "role" "description" ]
      ]
      .table = "employees" [
        set _t0 table:get $#employees "Fashion1+sales-rep"
        set _t1 table:get $#employees "Fashion2+sales-rep"
        set _ignore-keys [ "company" "role" "shape" "size" "color" "description" ]
      ]
      ; Error case: unrecognized
      [ error (word "The table type \"" .table "\" is not recognized." ) ]
    )
    
    foreach table:keys _t0 [ key ->
      if ( not member? key _ignore-keys ) [
        let _v0 (word table:get _t0 key)
        let _v1 (word table:get _t1 key)
        if ( _v0 != _v1 ) [
          set _msg (word _msg "WARNING: The values for " key " in the \"" .table "\" table differ!\n" key "=" _v0 " for " .table "(0) and " key "=" _v1 " for " .table "(1)\n\n")
          set _discrepancies? true
        ]
      ]
    ]
  ]
  
  ifelse (_discrepancies? ) 
  [ user-message _msg ] ; If there are discrepancies, create a popup warning.
  [ dprint 1 "compare-param-tables" (word "No discrepancies found in parameter tables " _tables-to-check ) ]
  
end

;; ----- merged from Includes/GLOBALS-CONTROL.nls -----
;;
;; ===================================== GLOBALS-CONTROL.NLS ===================================== 
;;
;; This include file contains generic procedures for controlling global variables
;;
;;
;; The folllowing set of procedures make it possible to declare global variables that can either be initialized in code,
;; or through a widget in the interface. By using this convention, you can add and remove widgets without causing errors.
;;
;; The code requires a few things in the main netlogo file:
;;      * There needs to be a global variable called $error
;;      * All global variables declared in the code begin with $, e.g. "$my-var"
;;      * Widgets to control globals will have a variable that has the same name but without the $, e.g. "my-var"
;;
;; You can then set and update globals as follows.
;; * In the main file, make sure in your global [ ] section you declare a variable $my-var
;; * To initialize it to a default value, say, 10, and leave it alone, you could do two things:
;;      1.   set $my-var 10 ; The traditional way
;;      2.   wset$ "my-var" 10 ; This allows you to add or remove a widget to control $my-var
;;      3.   set$ "my-var" 10 ; This is done instead of 1. in case you want to quickly switch to the widget-controllable version (change set$ to wset$)
;;
;; * If you have used wset$ (example 2. above), then if you create a widget with the global-variable my-var (no $!), any changes to the widget will be
;;   reflected in changes to $my-var. And if you later delete the widget, $my-var will simply be set to the default value.
;;
;; * The function wupdate$ takes the name of a variable (without $) and updates it, if a corresponding widget exists
;;
;; All three of these functions (set$, wset$, wupdate$) do extensive sanity checks. They will throw an error if you try to set/updated a global variable
;; that has not been declared in globals [ ], and if you try to wset$ or $update but there is no widget, they will generate a warning.

;; Checks if a global variable has been declared or not. Sets the global $error flag accordingly
to check-var [ .gvar ]
  set $error false
  carefully 
  [ run (word "set " .gvar " " .gvar ) ] ;; This is a no-op that will throw an error if the var does not exist.
  [ 
    set $error true
    dprint 2 "check-var" error-message
  ] 
end


;; Initializes a global variable using either an interface widget or a provided default value
to wset$ [ .varname .default ]
  
  ; If running desktop, check things carefully
  ifelse ( not netlogo-web? ) [
    check-var (word "$" .varname)
    let _var-exists? not $error
    check-var (word .varname)
    let _widget-exists? not $error
    
    ifelse _var-exists?
    [    
      ifelse _widget-exists?
      [
        ;; Both the global $var and widget var exist.
        run (word "set $" .varname " " .varname ) 
        ; We create a table entry for this global to be used later - we use the global table $#globals
        table:put $#globals (word "$" .varname) (list .default "Y" runresult (.varname))
      ]
      [
        ;; The global exists, but not the widget - generate a warning
        dprint 1 "wset$" (word "widget for variable " .varname " does not exist. Setting $" .varname " to default value (" .default ")" )
        run (word "set $" .varname " " .default )
        ; We create a table entry for this global to be used later - we use the global table $#globals
        table:put $#globals (word "$" .varname) (list .default "N" "-")
      ]
    ]
    [
      ;; The global does not exist - generate an error
      error (word "ERROR (wset$): global variable $" .varname " does not exist.")
    ]
  ]
  [
    ; If we are running this as html, we don't need all these checks
    run (word "set $" .varname " " .varname )
  ]
 
end

;; Initialize a global to a specific value (not from a widget)
to set$ [ .varname .default ]
  check-var (word "$" .varname)
  let _var-exists? not $error
  check-var (word .varname) ;; Note: we want to make sure the use is not accidentally trying to set this var from a widget and calling set$
  let _widget-exists? not $error
  
  ifelse (_var-exists?)
  [
    if (_widget-exists?) ;; Generate a warning if the user added a widget but is still trying to use "set$"
    [ 
      let msg (word "A widget for the variable " .varname " exists, but it's ignored because $" .varname " is initialized to its default value (" .default ") with set$.\n\nUse wset$ instead of $set in initialize-globals if you want to use the widget." )  
      dprint 1 "set$" msg
      user-message msg
    ]
    run (word "set $" .varname " " .default ) 
    dprint 2 "set$" (word "$" .varname " set to default value (" .default ")" )
  ]
  [
;    dprint 0 "set$" (word " $" .varname " does not seem to exist" )
    error (word "ERROR (set$): global variable $" .varname " does not exist.")
  ]
end

;; Updates a global variable using an interface widget
to wupdate$ [ .varname ]
  check-var (word "$" .varname)
  let _var-exists? not $error
  check-var (word .varname)
  let _widget-exists? not $error
  
  ifelse _var-exists?
  [
    ifelse _widget-exists?
    [
      ;; Both the global $var and widget var exist.
      run (word "set $" .varname " " .varname ) 
      ; We update the table entry for this global to be used later - we use the global table $#globals
      table:put $#globals (word "$" .varname) replace-item 2 ( table:get $#globals (word "$" .varname) ) (runresult (.varname))
    ]
    [
      ;; The global exists, but not the widget - generate a warning
      dprint 1 "wset$" (word "widget with variable " .varname " does not exist. Global variable $" .varname " unchanged." )
    ]
  ]
  [
    ;; The global does not exist - generate an error
    error (word "ERROR (wupdate$): global variable $" .varname " does not exist. Check your code!")
  ]  
end

; Print out the globals table with relevant info as a user message (pop-up)
to display-globals
  let msg "LIST OF CONTROLLABLE GLOBALS:\n$varname  [ default   widget?  value ]\n"
  foreach table:keys $#globals [ k -> set msg (word msg k ": " table:get $#globals k "\n") ]
  
  user-message msg
  
end

; Print out the globals table with relevant info
to print-globals
  let msg "LIST OF CONTROLLABLE GLOBALS:\n$varname  [ default   widget?  value ]\n"
  foreach table:keys $#globals [ k -> set msg (word msg k ": " table:get $#globals k "\n") ]
  
  print msg
  
end

;; The procedure below already exists in the main netlogo file, adding it here for those who may need it separately
;; The procedure requires that you have a global variable called $debug-level that determines what level of messages are printed.
