;; Netlog built-in extensions (if needed)
extensions [ table palette csv array dialog]

;; Set up agent breeds
breed [ companies company ] ; Treat the company as an agent as well?
breed [ employees employee ]
breed [ sprites sprite ]
breed [ tasks task ]
;breed [ dots dot ] ; Used for the VCR-like time slider
breed [ bars bar ] ; Used to draw bar charts

turtles-own [
  ; Sometimes it's convenient to have a number that reflects your order in your set of agents.
  my-number

  ; These are all variables that can be applied to multiple types of
  #tracked-vars ; Every agent type owns a table that tracks certain e-vars at every time step
  #xy-commands ; Every agent needs to know how to update its position based on information in this table
  #daily-events ; A table of events during the day
  daily-activities ; This is a list that is reset daily
  my-next-activity ; This will hold an anonymous function determining what to do next

  my-sprite ; Sprite pointer

  daily-hours-scheduled
  daily-tardy-time
  daily-hours-worked
  daily-customers-helped
  daily-sales-closed
  daily-tasks-failed
  daily-productivity
  daily-misc-task-time
  daily-idle-time
  daily-rest-time

  total-hours-scheduled
  total-tardy-time
  total-hours-worked
  total-customers-helped
  total-sales-closed
  total-tasks-failed
  total-productivity
  total-misc-task-time
  total-idle-time
  total-rest-time

  ; Other variables
  my-color

]

;; Company variables
companies-own [
  industry ; The company's industry. This is the main label to identify company types
  name ; The store name
  description ; A brief description of the store

  ; Financials
  ; PG: Eventually these should become tables with different timelines, e.g., quarterly, monthly, etc.
  ; PG: One option is simply to make these time series, and then have functions that can extract the right periods...
  daily-employee-revenues
  daily-non-employee-revenues
  daily-non-employee-sales-closed
  daily-gross-revenues
  daily-labor-costs
  daily-COGS
  daily-profits
  total-employee-revenues
  total-non-employee-revenues
  total-non-employee-sales-closed
  total-gross-revenues
  total-labor-costs
  total-COGS
  total-profits

  ; HR
  num-employees
  my-employees ; A turtle-set
  my-average-employees ; Used to track average across all employees


  ; Stipends for hourly and salaried workers

  ; Operations
  business-open?
  #daily-coverage
  daily-gap-time
  total-gap-time
  max-daily-coverage

  ; The following variables are red in from the csv file
  SOB ; Start of business day
  EOB ; End of business day
  job-quality ; Overall indicator, to be refined later
  markup ; Markup to estimate the raw cost of goods sold

  ; Tracked variables
  #company-tasks
  ; daily-misc-tasks
  daily-customer-visits
  total-customer-visits
  daily-tasks-expired
  total-tasks-expired
  daily-misc-tasks-list

  ; Schedule


  ; Flex time and other work-life balance policies

  ; Display stuff
  my-bars


]

;; Employee variables
employees-own [

  ;; VARIABLES THAT ARE SET AT INITIALIZATION
  #role-params ; A table of parameters, read in from a file, to set some of the initial variable

  ; Who is my employer?
  my-company ; The company's turtle/agent
  my-company-name ; The company name

  ; Role / career-related
  role ; My role, e.g., "sales-rep"
  rank
  tenure
  pay-amount

  ; An identifier used as index for various tables, which combines role and company name
  class

  ; An identifier used for a special kind of employee that averages all the employees in one class
  average?
  tracked-colleagues ; this is an agentset used only by the average agent

  ; Personal traits - these are read in from a file but may change during the simulation
  skill-level
  absent-rate
  tardy-rate

  satisfaction
  productivity
  work-quality

  ; Schedule-related variables
  schedule-type ; What sort of schedule I am using
  min-hours ; Minimum (daily) hours that can be scheduled for this employee
  max-hours ; Maximum (daily) hours that can be scheduled for this employee

  ; Daily variables related to scheduling
  schedule-today ; My schedule for today
  start-time
  end-time
  tardy-counter
  absent-counter
  absent? ; This reflects unexpected absences
  working? ; A flag to turn on when the employee is actually at work and being productive
  brake-taken? ; Toggle whether someone has taken a break or not

  ; Task-related
  all-activities ; This is the cumulative list of activities
  current-task

  ; Money earned
  daily-earnings
  total-earnings

  ; Money generated for the company
  daily-revenues
  total-revenues

  ; Events
;  personal-events
;  workplace-events
;  hr-events
;  company-events


]

;; Sprites are used to visualize some aspects of the agents
sprites-own [
  my-parent
  p-var ; What variable of their parent the sprite is tracking
  my-shape ; What shape will I take on
  col-min ; The minimum value to use for the sprite's color range
  col-max ; The maximum value to use for the sprite's color range
  rel-x ; My x position relative to my parent's position
  rel-y ; My y position relative to my parent's position

]


;; Bar agents are used to display bar charts. Similar to sprites but fixed position, size/shape changes with tracked variable.
bars-own [
  my-parent
  my-block
  p-var
  my-factor
  my-units
  bar-thickness
]


;; Task "agent" variables
tasks-own [
  my-company
  my-employee
  my-task-description
  my-type
  my-role
  created-time
  expiration-time
  completion-time
  posted?
  started?
  completed?
  my-value
  prob-success
]


;;; Some variables for patches
patches-own [
;  show-label  ; patches that should have a label
  patch-type ; What type of patch is this? E.g., "wall" "space" "floor" etc.
  display-area ; Handle the possibility of multiple display areas
  level ; Only relevant for multi-level display areas
]

;;; create global variables - see the procedure initialize-globals for decriptions
globals
[
  ;; Naming conventions:
  ;; starting with $ represents a global variable
  ;; starting with $# represents a global table

  ;; General globals
  $debug-level
  $trace-day ; Used to do a full-day trace (if wanted)
  $error
  $#globals
  $use-r-seed?
  $r-seed
  $nlw-startup? ; Used to print a warning message the first time we load from NetLogo Web
  $nlw-first-run? ; Used to print a warning message the first time we run from NetLogo Web


  ;; time-related globals
  $sim-time
  $sim-time-units
  $sim-start-date
  $sim-duration

  ;; event-related globals. Use "es" for "event scheduler"-related variables
  $es-ticks-per-week ; How many ticks happen each week
  $es-ticks-per-day ; How many ticks happen each day
  $es-ticks-per-hour ; How many ticks happen each hour
  $es-daily-time ; Keep track of the time of day (reset daily
  $es-clock-time ; Array holding clock-like time format hh:mm for the entire day
  $es-events-list ; A list of when the next event(s) will occur
  $#es-daily-events ; This is a table that keeps track of daily events
  $es-workday-start-time
  $es-workday-end-time

  ;; ----- Parameters for the display -----------

  ;; Display parameters

  $displays-par-file ; The csv file that holds the information about the space
  $displays-params ; The string that will hold information about the displays
  $#displays ; This table will hold all the display parameters for different display areas
  $display-ticks ; Determine how often the display is updated

  ; These two lists hold shape names used to draw horizontal (x) or vertical (y) bar charts
  $xbar-shapes
  $ybar-shapes
  $display-patch ; Will need to assign one to each bar - maybe a sprite?

  ;; Tracker parameters
  $tracked-vars-par-file ; The csv file that holds the information about the space
  $tracked-vars-params ; The csv file that holds the information about the space
  $#tracked-vars ; This table will hold all the display parameters for different display areas
  $track-vars? ; Toggle whether or not to track vars at runtime.

  $world-color
  $world-patches ; The patch set of patches not part of the employee space

  ;; Floors (for multi-level simulations)
  $num-levels


  ;; Timeline - the progress bar that can be shown at the bottom of the employee space
;  $show-timeline
;  $timeline-offset
;  $timeline-width
;  $timeline-future-color
;  $timeline-past-color
;  $timeline-patches
;  $timeline-dot
;  $timeline-label

  ;; ----------------- employee parameters ----------------
;  $num-ranks
  $pen-down?
  $average-employee?
  $average-employees ; will be the set of employee agents that represent company averages
  $make-up-for-tardy? ; This determines whether if an employee is tardy they will stay later or simply shorten their day
  $max-sat ; What is the max satisfaction of employees before initiatives are turned off?
  $sat-add ; How much each initiative impacts satisfaction

  $x-var ; which specific variable controls the x position
  $employee-display-var ; Which variable controls the Y position to display for employees
  $company-display-var ; Which variable controls the Y position to display for companies


  ;; ----------- Sprite parameters
  $sprites?  ; Whether or note sprites are shown
  $sprite-var ; Which employee variable is shown by the sprite


  ;; -------------------- Company parameters
  $companies-par-file ; The name of the file holding the company parameters
  $companies-params ; The string that will hold the company params
  $#companies ; A table of tables defining the companies for this simulation
  $industry ; Specifies the industry and sector of the company being simulated ;PG DEPRECATE
  $scenario ; Choose a specific scenario (typically related to company parameters being tested)
  $advance-notice? ; Does the company give employees their schedules well in advance?
  $minimum-hours? ; Does the company guarantee a minimum number of hours?
  $schedule-swaps? ; Does the company allow employees to swap schedules?
  $better-pay? ; Does the company pay employees less money?

  ; Track how many tasks are being posted, assigned and completed today
  ; PG idea: this should be automated, and specified in a way that it can be done flexibly, e.g., weekly monthly, quarterly, through an external file.
  $daily-tasks-posted
;  $daily-customers-helped
;  $daily-sales-closed
;  $daily-tasks-expired
;  $total-tasks-posted
;  $total-customers-helped
  $total-sales-closed
;  $total-tasks-expired
  $#company-tasks ; A table of lists of company tasks
  $misc-tasks ; A global list of misc, non-revenue tasks
  $misc-task-names ; Names of the misc tasks (used for reporting/printing)

  ; These are used for various types of parameters read in from a file or from lists.
  $param-source ; A generic holder of the name of the file or list containing the parameters being processed
  $num-parsed-params ; Used to track how many parameters are found in each line of parsed parameter files.
  $par-formats ; Used to store the formats temporarily

  ;; ----------------- Role-related parameters
  $employees-par-file  ; The name of the file holding information about the employees
  $employees-params ; The string holding the employee parameters
  $#employees

  ;; --------------------- Task globals
  $tasks-par-file ; The name of the file holding the task parameters
  $tasks-params ; The string holding the task parameters
  $#tasks ; A table of tables defining the tasks that exist for this specific industry
  $#task-q ; A table holding a queue of tasks for each role type
  $t-num-assigned ; An index of how many tasks have been assigned to employees
  $t-num-completed ; An index of how many tasks have been completed by employees.

  ;; -------------- TEST area
  ; Set some test globals to experiment in the osberver area
  $t0
  $t1
  $t2
  $t3
  $#t0
  $#t1
  $#t2
  $#t3


]


;;==================================== Procedures =========================

to initialize-globals
  ;; To allow for seamless switching between widgets and hard-coded globals, we have two functions:
  ;; - set$ takes two parameters: (1) the global variable name WITHOUT the leading $, and (2) the default value to which the variable will be set.
  ;; - wset$ takes the same two parameters, but if a widget with the same variable name (without $) exists, it will use that widget instead of the default.
  ;; To initialize a variable that will likely never be set through a widget, use set$, otherwise use wset$
  ;;
  ;; PLEASE NOTE: these functions assume that all global variables start with $ and that any widget controlling that variable will have the same name but no $.
  ;;
  ;; NOTE also: any variable that is calculated or used as a constant should use regular "set"

  ;; -------- General globals
  set $#globals table:make ; This must be the first init, before any calls to wset$
  set $debug-level debug-level ; From interface
  set $trace-day -1 ; Setting this to -1 means no tracing will occur. Otherwise on the specified day some information will be dumped out.
  set $use-r-seed? use-r-seed? ; From interface
  if $use-r-seed? [
    set $r-seed 99 ; it does not matter which particular seed we use
    print (word "NOTE: Using random seed " $r-seed " for repeatability.")
    random-seed $r-seed ]

  ;; -------- Time-related globals
  set $sim-time-units "days" ; The time unit that corresponds to each tick
  set $sim-duration sim-duration ; From interface
  ;; --------- Event-related globals
  set $es-ticks-per-hour 60 ; By default use one-minute ticks
  set $es-ticks-per-day 24 * $es-ticks-per-hour
  set $es-ticks-per-week 7 * $es-ticks-per-day
  set $es-clock-time array:from-list n-values ( $es-ticks-per-day + 1 ) [ t -> time-of-day t ] ; Create an array of clock times for the whole day.
  set $#es-daily-events table:make ; This will keep track of the turtle-sets with events assigned at certain times.

  ;; ----------- DISPLAY globals

  set $#displays table:make ; Initialize the global table of display parameters
  set $displays-par-file "Params/displays.csv" ; The name of the file containing the display variables
  set $display-ticks display-ticks ; From interface

  ;; Trackers
  set $#tracked-vars table:make ; Initialize the global table of trackers parameters
  set $tracked-vars-par-file "Params/tracked-vars.csv" ; The name of the file containing the trackers variables
  set $track-vars? track-vars? ; From interface

  set $world-color 2

  set $num-levels 1

  ;; Timeline (the VCR-like progress bar)


  ;; -------------- Employee params

  set $pen-down? true
  set $average-employee? average-employee? ; From interface
  set $make-up-for-tardy? true
  set $max-sat 1.0
  set $sat-add sat-add ; From interface

  ; Now set the default variables to use in the display
  set $x-var "ticks"
;  wset$ "y-var" "\"satisfaction\""
  set $employee-display-var employee-display-var ; From interface
  set $company-display-var company-display-var ; From interface

  ;; --------------- Sprite params
  set $sprites? false  ; This controls whether or not the sprites are shown
  set $sprite-var "satisfaction" ; By default, link sprite color to the employee's satisfaction

  ;; --------------- Company params
  ; Specify the file to use for the company's task parameters list
  set $companies-par-file "Params/companies.csv" ; The name of the file containing the list of companies
  set $#companies table:make ; Create a table of companies (to be initialized later)
  set $industry "retail-fashion" ; The industry and sector of the company being simulated
  set $scenario "No differences"
  set $advance-notice? advance-notice? ; From interface
  set $minimum-hours? minimum-hours? ; From interface
  set $schedule-swaps? schedule-swaps? ; From interface
  set $better-pay? better-pay? ; From interface

  ;; ------------ Role-related parameters
  set $employees-par-file "Params/employees.csv" ; The name of the file containing the task list
  set $#employees table:make ; Create a table of roles (to be initialized later)

  ;; ----------- Task parameters
  set $tasks-par-file "Params/tasks.csv" ; The name of the file containing the task list
  set $#tasks table:make ; Create a table of tasks (to be initialized later)
  set $#task-q table:make ; Create a table for the task queue (to be initialized later)
  set $t-num-assigned 0 ; Initialize
  set $t-num-completed 0 ; Initialize
  set $#company-tasks table:make ; Initialize the table for lists of store tasks by role

  ;; -------- TEST

end

;; Invoke the initialization automatically.
to startup
  if not netlogo-web? [ initialize ] ; By skipping this, at least the interface shows up immediately in NLW
end

;; Initialization
to initialize
  if ( netlogo-web? and $nlw-startup? = 0 ) [ user-message ("NOTE: initialization can take a minute or more the first time the code is loaded.\nIf your browser says the program is not responding, tell it to continue anyway.\nAlso, the first time you press RUN it will take several seconds to start, but after that, initializing and running will be much faster.\n\nPress OK to start initialization.") ]
  let _tmp $nlw-startup? ; Note: local variables are NOT cleared by clear-all. Use this to know whether this is the first INIT in the web version
  clear-all
  ; Note: in the line below setting $nlw-startup to _tmp will cause the pop-ups before each command the first time this is loaded in NLW, setting it to 1 will skip the pop-ups
  set $nlw-startup? 1; _tmp
  clear-output
  stop-inspecting-dead-agents
  reset-timer
  reset-ticks
  print "\n\n--------  INITIALIZING NEW RUN  --------"
  if ( not netlogo-web? ) [ set $nlw-startup? 1 ] ; Skip all the warnings
  if ( $nlw-startup? = 0 ) [ user-message ("Initialize globals") ]
  initialize-globals
  if ( $nlw-startup? = 0 ) [ user-message ("Initialize params") ]
  initialize-params ; If running NLW, this function initializes a bunch of lists that will otherwise be read in from .csv files. Otherwises it's a no-op
  if ( $nlw-startup? = 0 ) [ user-message ("setup-display") ]
  setup-display
  if ( $nlw-startup? = 0 ) [ user-message ("setup trackers") ]
  setup-trackers
  if ( $nlw-startup? = 0 ) [ user-message ("setup companies") ]
  setup-companies
  if ( $nlw-startup? = 0 ) [ user-message ("setup scenario") ]
  setup-scenario ; Note: for now the scenario is at the company level, so it needs to be run here as it is likely to impact the employee initialization
  if ( $nlw-startup? = 0 ) [ user-message ("setup employees") ]
  setup-employees
  if ( $nlw-startup? = 0 ) [ user-message ("setup display trackers") ]
  initialize-display-trackers
  if ( $nlw-startup? = 0 ) [ user-message ("setup tasks") ]
  setup-tasks
  compare-param-tables

  print (word "=======> Initialization complete!\n\n")
  set $nlw-startup? 1 ; This prevents the warnings in "initialize" after the first time the code is loaded


  reset-ticks
end

;; GO Loop
to go

  ifelse ticks = 0
  [ ask patch ( world-width / 2 ) (world-height / 2 ) [ set plabel "Please wait..." ] ]
  [ ask patch ( world-width / 2 ) (world-height / 2 ) [ set plabel "" ] ]

  if  ticks > $sim-duration [
    ; Update final display and stats before quitting
    update-display
    view-YTD-company-stats
    stop
  ]

  ; Daily activities
  run-daily-events
  if ticks mod $display-ticks = 0 [ update-display ]
  update-bar-charts
  ; Monthly or quarterly updates
  if (ticks mod 30 = 0) [ view-YTD-company-stats ]

  tick
end


;; This procedure runs the daily events
to run-daily-events
  let _active-steps 0

  ; Take care of things at the start of the day
  set $es-daily-time 0 ; Let the day begin!
  set $es-events-list [] ; Wipe the daily events list clean
  foreach n-values ( $es-ticks-per-day + 1 ) [ t -> t ] [ t -> table:put $#es-daily-events t nobody ] ; Reset the table of agents doing events at each time

  ; Ask companies to start their day
  ask companies [
    schedule-my-event [ -> open-business ] SOB
    ; open-business
  ]

  set $es-events-list sort $es-events-list ; Start with a sorted list

  ; Now we loop through the entire day in minute increments, driven by the event scheduler
  while [ $es-daily-time <= $es-workday-end-time ] [
    if (ticks = 30 and $es-daily-time mod 60 = 99) ; Make the final number larger then the mod, and it will never print anything.
    [
      print (word calendar-time $es-daily-time "Events list:" $es-events-list)
      print (word "  Next event agents: " [ who ] of table:get $#es-daily-events first $es-events-list)
      print (word "  Tasks created today: " [ who ] of tasks with [ expiration-time > $es-daily-time ] )
      user-message "Continue"
    ]
    if ( length $es-events-list = 0 ) [
      print (word "At time " $es-daily-time " the events list $es-events-list is empty: " $es-events-list )
    ]
    if ( $es-daily-time = first $es-events-list ) [ ; There are some events to do at this time
      ask table:get $#es-daily-events $es-daily-time [ run my-next-activity ] ; Invoke the set of agents who have events at this time
      set $es-events-list sort ( but-first $es-events-list ) ; Now remove this time from the list and re-sort the list (as new events may have been added)
      dprint 4 "run-daily-events" (word ">>> At time " $es-daily-time " we executed some tasks. The new list of events is " $es-events-list)
      set _active-steps _active-steps + 1 ; This is just temporary to keep track of how many time slots had events
    ]
    ifelse ( length $es-events-list > 0 )
    [
      set $es-daily-time first $es-events-list ; By doing this we potentially save some time, skipping minutes when there are not events scheduled.
    ]
    [
      if ( $es-daily-time < $es-workday-end-time )
      [
        dprint 2 "run-daily-activities" (word calendar-time $es-daily-time ": Looks like we ran out of things to do before the end of the day." )
      ]

      set $es-daily-time $es-workday-end-time + 1 ; The list is empty, time to quit
    ]
  ]

  ask companies [ close-business ]

  ask tasks [ die ] ; There should be no remaining tasks at the end of each day

  ; Reached the end of the day - clear the list
 ; print (word calendar-time $es-daily-time ": Day is over. Tasks: created " [ daily-customer-visits ] of companies ", assigned " [ daily-customers-helped ] of companies ", completed " [daily-sales-closed] of companies )
  if ( length $es-events-list > 0 ) [ print (word " ---> Some events remain on the list: " $es-events-list)]

end


; Set up a specific scenario based on the interface settings
to setup-scenario

;  print (word "Setting up scenario \"" $scenario "\":" )

  let _reference-company min-one-of companies [ who ]
  let _test-company max-one-of companies [ who ]

  ; To set a different color that reflects the job quality, we set flags and match the color accordingly
  let _flags 0
  let _comp-colors [ 63 46 26 14 124 ]


  let _jq0 [ job-quality ] of _reference-company
  let _jq1 _jq0

  let _sat $max-sat
  ; let _sat-add (list $sat-add $sat-add $sat-add $sat-add ); this determines how much each JQ factor influences overall JQ
  

  if not $advance-notice? [
    set _sat _sat - $sat-add
    ; set _sat _sat - item _flags _sat-add
    set _flags _flags + 1
  ]
  if not $minimum-hours? [
    set _sat _sat - $sat-add
    ; set _sat _sat - item _flags _sat-add
    set _flags _flags + 1
  ]
  if not $schedule-swaps? [
    set _sat _sat - $sat-add
    ; set _sat _sat - item _flags _sat-add
    set _flags _flags + 1
  ]

  if not $better-pay? [
    set _sat _sat - $sat-add
    ; set _sat _sat - item _flags _sat-add
    set _flags _flags + 1
  ]

  set _jq1 precision ( _sat * _jq0 ) 2

  ask _reference-company [ set label-color color ]

  ask _test-company [
    set job-quality _jq1
    set color item _flags _comp-colors
    set label-color color
    set my-color color-name color
    dprint 2 "setup-scenario" (word "We set " _flags " flags, the resulting satisfaction is " _jq1 ", and the color is " color )
  ]
  let _msg ""
  if ( _jq0 = _jq1 ) [ set _msg "\n  ==> The performance of the two companies should be nearly identical!" ]
  set _msg (word "When you click \"Go!\" you will run a scenario with:\n  job-quality=" _jq0 " for " [ name ] of _reference-company "\n  job-quality=" _jq1 " for " [ name ] of _test-company _msg )

  ; Choose below whether you want a brief summary of the scenario printed out to the command center, or shown as a pop-up
  dprint 0 "setup-scenario" _msg
;  user-message _msg

end
;; ----- merged from Includes/COMPANY.nls -----
;;
;; ================================ COMPANY.nls =============================
;;


;; Initial setup of companies (V2
to setup-companies
  ; Initialize the companies from a file
  initialize-from-source "companies"
  
  ; Create one agent for each key
  foreach table:keys $#companies [ cname ->
    create-companies 1 [
      set my-number who - [ who ] of min-one-of companies [ who ] ; This should set the company numbers to 0, 1, 2, ... regardless of when created
      set hidden? true
      set name cname
      let _#cparams table:get $#companies cname
      set shape table:get _#cparams "shape"
      set color table:get _#cparams "color"
      set label-color color
      set my-color color-name color
      set size table:get _#cparams "size"
      set my-employees nobody
      set SOB minutes-of-day table:get _#cparams "sob"
      set EOB minutes-of-day table:get _#cparams "eob"
      set job-quality table:get _#cparams "job-quality"
      set markup table:get _#cparams "markup"
      set #daily-events table:make
      set #daily-coverage table:make ; wipe it clean every day.
      set my-bars nobody
      init-tracked-vars
    ]
  ]
  
  ; Now set the overall start and end of business hours based on this
  set $es-workday-start-time min [ SOB ] of companies
  set $es-workday-end-time max [ EOB ] of companies
  
  ; Now create the global table of miscellaneous tasks, which is the same for all companies
  create-misc-tasks
      
end

;; Open the business
to open-business
  
  ; Reset some counters for daily stats
  set daily-employee-revenues 0
  set daily-non-employee-revenues 0
  set daily-non-employee-sales-closed 0
  set daily-gross-revenues 0
  set daily-labor-costs 0
  set daily-COGS 0
  set daily-profits 0
  set daily-customer-visits 0
  set daily-customers-helped 0
  set daily-sales-closed 0
  set daily-tasks-failed 0
  set daily-tasks-expired 0
  set daily-activities []
  set #daily-events table:make ; Wipe it clean every day
  set #daily-coverage table:make ; Wipe it clean every day
  foreach ( n-values ( EOB - SOB + 1) [ t -> clock-time ( t + SOB) ] ) [ k -> table:put #daily-coverage k 0 ]

  create-daily-misc-tasks-list ; This initializes a bunch of random misc tasks for employees to do in-between customers

  set business-open? true
  
  ; Schedule the first task for the day
  foreach ( table:keys $#tasks ) [ t -> 
    let _task table:get $#tasks t
    ; Look for tasks for this company and schedule it for some time after opening
    if ( name = table:get _task "company" ) [
      schedule-my-event [ -> task-arrives _task ] $es-daily-time + task-gap _task
    ]
  ]
  
  ;  ; Now tell all employees to start their day
  ask my-employees [
    start-my-day
  ]

  dprint 2 "open-business" (word who-when "Has just opened for the day. Planning to close at " clock-time EOB )
  
end


;; Close the business
to close-business
  
  ; Some end-of-day sanity checks
  if daily-customers-helped = 0 [
    dprint -1 "close-business" (word who-when "did not have any tasks today. WTF?")
  ]
  
  ; Ask your employees to end their day
  ask my-employees [ end-my-day ]
  
  ; We want to make sure that all employees have quit for the day, otherwises totals will be off
  let _working-employees my-employees with [ working? = true ]
  if any? _working-employees [
    dprint -1 "close-business" (word name ": Something is wrong, at end of day some employees are still working. List: " [who] of my-employees )
  ]
    
  ; Calculate employee idle time and coverage gap time
  set daily-gap-time 0
  set max-daily-coverage 0 ; Tracks the max # of employees during the day
  foreach table:keys #daily-coverage [ key ->
    let _cvg table:get #daily-coverage key
    if ( _cvg = 0 ) [ set daily-gap-time daily-gap-time + 1 ]
    if ( _cvg > max-daily-coverage ) [ set max-daily-coverage _cvg ]
  ]  
  set total-gap-time total-gap-time + daily-gap-time
  
  ; Now calculate daily and totals of various employee trackers
  set daily-tardy-time sum [ daily-tardy-time ] of my-employees
  set total-tardy-time total-tardy-time + daily-tardy-time
  set daily-misc-task-time sum [ daily-misc-task-time ] of my-employees
  set total-misc-task-time total-misc-task-time + daily-idle-time
  set daily-idle-time sum [ daily-idle-time ] of my-employees
  set total-idle-time total-idle-time + daily-idle-time
  set daily-rest-time sum [ daily-rest-time ] of my-employees
  set total-rest-time total-rest-time + daily-rest-time
  set daily-sales-closed sum [ daily-sales-closed ] of my-employees
  set daily-tasks-failed sum [ daily-tasks-failed  ] of my-employees
  set total-tasks-failed total-tasks-failed + daily-tasks-failed 
 
  ; Now add daily totals to cumulative totals
  set total-customer-visits total-customer-visits + daily-customer-visits
  set total-customers-helped total-customers-helped + daily-customers-helped
  set total-sales-closed total-sales-closed + daily-sales-closed
  set total-tasks-expired total-tasks-expired + daily-tasks-expired
 
  
;  The commented code was doing some sanity check, but it seems to work to simply sum revenues from the employees on a daily basis
;  let _cd sum [ daily-revenues ] of my-employees
;  if ( _cd != daily-revenues ) [
;    dmsg 0 "close-business" (word name ": accrued daily revenues (" daily-revenues ") and total employee dailly revenues (" _cd ") do not match!" )
;  ]
  set daily-employee-revenues sum [ daily-revenues ] of my-employees
  set daily-gross-revenues daily-gross-revenues + daily-non-employee-revenues + daily-employee-revenues
  set daily-labor-costs sum [ daily-earnings ] of my-employees
  set daily-COGS daily-gross-revenues * ( 1.0 - markup )
  set daily-profits daily-gross-revenues - daily-labor-costs - daily-COGS ; We assume the cost of the sold goods is based on a fixed markup
  set total-non-employee-revenues total-non-employee-revenues + daily-non-employee-revenues ; Note that this is NOT tracked by employees
  set total-non-employee-sales-closed total-non-employee-sales-closed + daily-non-employee-sales-closed ; Note that this is NOT tracked by employees
  set total-employee-revenues total-employee-revenues + daily-employee-revenues
  set total-gross-revenues total-gross-revenues + daily-gross-revenues
  set total-labor-costs total-labor-costs + daily-labor-costs
  set total-COGS total-COGS + daily-COGS
  set total-profits total-profits + daily-profits
  
  ; More sanity check - the total number of tasks assigned and completed are tracked independently by company and employees and the numbers should match
;  let _emp-ta sum [ daily-customers-helped ] of my-employees
;  let _emp-tc sum [ daily-sales-closed ] of my-employees
;  if ( daily-customers-helped != _emp-ta or daily-sales-closed != _emp-tc ) 
;  [
;    dprint -1 "close-business" (word who-when "thinks that " daily-customers-helped " tasks were assigned and " 
;     daily-sales-closed " completed, but employees report " _emp-ta " tasks assigned and " _emp-tc " completed." )
;  ]
  
  set business-open? false
    
  dprint 2 "close-business" (word who-when "Has just closed for the day." )
  
end


;; Schedule-related


;; Add an employee to today's coverage table
to add-to-coverage [ .who .start .end ]
  foreach n-values ( EOB - SOB ) [ t -> t + SOB ] [ t ->
    if ( t >= .start and t <= .end ) [
      table-item++ #daily-coverage clock-time t
    ]
  ]
  
  dprint 3 "add-to-coverage" ( word who-when "added the schedule for E" .who )
    
end


;; Remove an employee from today's coverage table (typically during a break or when leaving early)
to reduce-coverage [ .who .start .end ]
  foreach n-values ( EOB - SOB ) [ t -> t + SOB ] [ t ->
    if ( t >= .start and t <= .end ) [
      table-item-- #daily-coverage clock-time t
    ]
  ]
  
  dprint 3 "reduce-coverage" ( word who-when "updated the schedule for E" .who )
    
end

;; ========= MISC TASKS
; This section of the code deals with miscellaneaous, non-revenue-generating tasks

; Create a list of misc tasks for each company (this happens once at initialization)
; Each task has the name, min time required, and how many times it will appear in the list.
to create-misc-tasks
  
  set $misc-tasks []  
  set $misc-task-names []
  
  ; For now we do this manually - for each task type specify the effort (in minutes) and the relative frequency
  add-misc-task "Inventory" 30 2 
  add-misc-task "Cashier" 15 6 
  add-misc-task "Restocking" 15 6 
  add-misc-task "Misc" 5 24 
  add-misc-task "Idle" 2 30 
  
  dprint 2 "create-misc-tasks" (word "Global list $misc-tasks is set to: " $misc-tasks )
  
  let _tot-misc-tasks 0
  let _tot-misc-time 0
  foreach $misc-tasks [ _tsk -> 
    set _tot-misc-tasks _tot-misc-tasks + 1
    set _tot-misc-time _tot-misc-time + item 1 _tsk
  ]

  dprint 2 "create-misc-tasks" (word "Initialized misc tasks list with " _tot-misc-tasks " tasks spanning " _tot-misc-time " minutes.")
  
end


; Add a single misc-tasks to the global lists
to add-misc-task [ .name .effort .prob ]
  
  repeat .prob [
    set $misc-tasks lput (list .name .effort ) $misc-tasks
  ]
  
  ; Now add the name to the list for tracking
  set $misc-task-names lput .name $misc-task-names

end  


; Create a random daily task list - this is invoked by each company
; This works as follows: the global misc-tasks-list has a bunch of entries based on create-misc-tasks. Each task has a minimum completion time
; Here we keep randomly plucking items from that list, and keep adding it to the (random) daily list for the company. As each misc
; task is added, we increment the effort. Once that effort exceeds the daily target times the number of employees, we stop. This results
; in a sequence of misc tasks that need to be executed during the day.
to create-daily-misc-tasks-list
  
  set daily-misc-tasks-list []

  let _tot 0

  repeat ( 1 * length $misc-tasks ) ; Make a randomized list that is NUM-EMPLOYEES times as long as the original
  [
    let _tsk one-of $misc-tasks
    let _name item 0 _tsk
    let _eff item 1 _tsk
    set _eff _eff + floor ( random ( 1 + _eff / 2.0 ) )
    set _tot _tot + _eff
    set daily-misc-tasks-list lput (list _name _eff ) daily-misc-tasks-list
  ]

  dprint 3 "create-daily-misc-tasks-list" (word who-when "has created a list of " length daily-misc-tasks-list " misc tasks, totaling " _tot " minutes of combined min work" )
end


;; ------------- Various company stats and reporting procedures


;; Do a sanity check of the files that have been parsed
to sanity-check-inputs
  let _role ""
  
  ; Make sure that all tasks are assigned to existing roles
  foreach table:keys $#tasks [ key -> 
    carefully [ set _role ( table:get ( table:get $#tasks key ) "role" )
      let _cname ( table:get ( table:get $#tasks key ) "company" )
      let _dummy ( table:get $#employees (word _cname "+" _role ) ) ; See if the specified role for this task exists.
    ] 
    [ dprint -1 "sanity-check-inputs" (word "The tasks param list $tasks-params has set tasks for role \"" _role "\", but no such role was specified in the employees parameters list in PARAMS.nls" ) ]
       
  ]
end


;; View daily company stats is for the report shown in the output box of the UI
to view-daily-company-stats
  
  let _msg (word "DISPLAYING DAILY FINANCIALS at the end of day " ticks ":\n")
  
  ; Prit out the company stats in order
  foreach ( sort companies ) [ c ->
    ask c [      
      set _msg (word _msg "\n COMPANY: " name " (" my-color ", " num-employees " employees):\n" )    
      set _msg (word _msg " - Daily customer visits: " daily-customer-visits"\n")
      set _msg (word _msg " - Daily customers helped: " daily-customers-helped " (" precision ( daily-customers-helped / num-employees ) 1 "/empl) \n")
      set _msg (word _msg " - Daily # of employee sales completed: " daily-sales-closed " (" precision ( daily-sales-closed / num-employees ) 1 "/empl) \n")
      set _msg (word _msg " - Daily employee revenues: " currency "$" daily-employee-revenues "\n")
      set _msg (word _msg " - Daily value per empl. sale: " currency "$" ( daily-employee-revenues / daily-sales-closed ) "\n")
      set _msg (word _msg " - Daily revenues from unassisted sales: " currency "$" daily-non-employee-revenues "\n")
      set _msg (word _msg " - Daily gross revenues: " currency "$" daily-gross-revenues "\n")
      set _msg (word _msg " - Daily labor costs: " currency "$" daily-labor-costs "\n")
      set _msg (word _msg " - Daily COGS: " currency "$" round ( daily-labor-costs + ( daily-gross-revenues * ( 1 - markup ) ) ) "\n" )
      set _msg (word _msg " - Daily profits: " currency "$" daily-profits "\n" )
      set _msg (word _msg " - Daily gross margin (w/" round ( markup * 100 ) "% mrkp): " precision ( 100 * daily-profits / daily-gross-revenues ) 1 "%\n")
    ]
  ]
  ; user-message _msg
  clear-output
  output-print _msg
  
end


;; Various reporters for generating KPIs
; Reporter for revenues per employee sale
to-report ATS-for-employee-sales
  report ( total-employee-revenues / total-sales-closed )
end

; Reporter for revenues per employee sale
to-report ATS-for-non-employee-sales
  ifelse (total-non-employee-sales-closed > 0) [
    report ( total-non-employee-revenues / total-non-employee-sales-closed )
  ]
  [
    report 0
  ]
end

; Reporter to calculate COGS
to-report cogs
  report round ( total-labor-costs + ( total-gross-revenues * ( 1 - markup ) ) )
end

; Reporter to calculate gross margin
to-report gross-margin
  report precision ( 100 * total-profits / total-gross-revenues ) 1
end



;; View YTD company stats for the output box in the UI
to view-YTD-company-stats

  let _msg (word "DISPLAYING YTD FINANCIALS at the end of day " ticks ":\n")
  
  ; Prit out the company stats in order
  foreach ( sort companies ) [ c ->
    ask c [      
      set _msg (word _msg "\n COMPANY: " name " (" my-color ", " num-employees " employees):\n" )    
      set _msg (word _msg " - Customer visits: " total-customer-visits " (" precision ( total-customer-visits / ( ticks + 1 ) ) 1 "/day)\n")
      set _msg (word _msg " - Customers helped: " total-customers-helped " (" precision ( total-customers-helped / ( num-employees * ( ticks + 1 ) ) ) 1 "/empl/day) \n")
      set _msg (word _msg " - # of employee sales completed: " total-sales-closed " (" precision ( total-sales-closed / ( num-employees * ( ticks + 1 ) ) ) 1 "/empl/day) \n")
      set _msg (word _msg " - Revenues from employee sales: " currency "$" total-employee-revenues "\n")
      set _msg (word _msg " - ATS for employee sales: " currency "$" ATS-for-employee-sales "\n")
      set _msg (word _msg " - Revenues from unassisted sales: " currency "$" total-non-employee-revenues " (" currency "$" ( total-non-employee-revenues / ( ticks + 1 ) ) "/day)\n")
      set _msg (word _msg " - ATS for non-employee sales: " currency "$" ATS-for-non-employee-sales "\n")
      set _msg (word _msg " - Gross revenues: " currency "$" total-gross-revenues " (" currency "$" ( total-gross-revenues / ( ticks + 1 ) ) "/day)\n")
      set _msg (word _msg " - Labor costs : " currency "$" total-labor-costs " (" currency "$" ( total-labor-costs / ( ticks + 1 ) ) "/day)\n")
      set _msg (word _msg " - COGS: " currency "$" cogs " (" currency "$" ( cogs / ( ticks + 1 ) ) "/day)\n" )
      set _msg (word _msg " - Profits: " currency "$" total-profits " (" currency "$" ( total-profits / ( ticks + 1 ) ) "/day)\n" )
      set _msg (word _msg " - Gross margin (w/" round ( markup * 100 ) "% mrkp): " gross-margin "%\n")
    ]
  ]
    
  ; user-message _msg
  clear-output
  output-print _msg
  
end


; Create a two-item list with the name of a reporter and the reporter value
to-report report-KPI-with-label [ .KPI ]
  report ( list .KPI runresult .KPI )
end


;; Report company stats as a list for BehaviorSpace output
to-report YTD-stats-list-for-all-companies

  let _output []
  foreach ( sort companies ) [ c -> set _output lput YTD-stats-list-for-company c _output ]
  report _output
  
end


;; Report company stats as a list for BehaviorSpace output for a single company .c
to-report YTD-stats-list-for-company [ .c ]
  
  let _output []
          
  ask .c [
    ; Generates a list of key, value pairs into a list
    set _output lput report-KPI-with-label "name" _output
    set _output lput report-KPI-with-label "total-customer-visits" _output
    set _output lput report-KPI-with-label "total-customers-helped" _output
    set _output lput report-KPI-with-label "total-sales-closed" _output
    set _output lput report-KPI-with-label "total-employee-revenues" _output
    set _output lput report-KPI-with-label "ATS-for-employee-sales" _output
    set _output lput report-KPI-with-label "total-non-employee-revenues" _output
    set _output lput report-KPI-with-label "ATS-for-non-employee-sales" _output
    set _output lput report-KPI-with-label "total-gross-revenues" _output
    set _output lput report-KPI-with-label "total-labor-costs" _output
    set _output lput report-KPI-with-label "cogs" _output
    set _output lput report-KPI-with-label "total-profits" _output
    set _output lput report-KPI-with-label "gross-margin" _output
  ]
  
  report _output
  
end

;; Generate a list of KPIs and EPIs - used for BehaviorSpace
to-report KPI-EPI-lists [ .c ]
  let _output []
  
  set _output YTD-stats-list-for-company .c ; First store the KPIs
  set _output lput final-average-employee-stats-for-company .c _output ; Now add EPIs
  
  report _output
end

; -- View the task table
to display-param-table [ .type ]
  
  let _msg (word "LIST OF " .type "\n")
  let _table (word "$#" .type)
  
  foreach table:keys runresult _table  [ i -> set _msg (word _msg "** " i ": " table:get runresult _table i "\n") ]
    
  user-message _msg
  
end
;; ----- merged from Includes/DISPLAY.nls -----
;;
;; ===================================== CREATE-SPACE.NLS ===================================== 
;;
;; This include file contains generic procedures for setting up the display
;;

;; This procedure creates the space and sets up some important tables that will be needed to update employee positions.
to setup-display
    
  ; To begin, we make all patches part of the world.
  ask patches 
  [ 
    set patch-type "world" ; by default, all patches are in the world
    set level -1 ; This means they are not part of any display area
    set pcolor $world-color
  ]
  
  initialize-from-source "displays" ; Process the display parameters (from PARAMS.nls or from a .csv file)
   
  foreach table:keys $#displays [ key -> create-display-new table:get $#displays key ]
    
end

; Create each display as specified in the display parameters file (this is the new and more powerful version)
to create-display-new [ .dtable ]
  
  ; Read in all the parameters. Most of these will be used more than once, so just get them all out now
  ; This is also a good sanity check to make sure the input file matches what we expect!
  let _breed table:get .dtable "breed" ; What breed of turtle this display is for.
  let _name table:get .dtable "name" ; The name of the display area
  let _levels table:get .dtable "levels" ; The number of levels in the display area
  let _Ox% table:get .dtable "Ox%" ; The display area X offset as a percentage of the overall world size
  let _Oy% table:get .dtable "Oy%" ; The display area Y offset as a percentage of the overall world size
  let _width% table:get .dtable "width%" ; The display area width as a percentage of the overall world width
  let _height% table:get .dtable "height%" ; The display area height as a percentage of the overall world width
;  let _orientation table:get .dtable "orientation" ; Currently not used - Landscape or Portrait
  let _c-color table:get .dtable "color" ; The display area canvas
  let _b-thickness table:get .dtable "b-thickness" ; The display area border thickness
  let _b-color table:get .dtable "b-color" ; The border color
  let _w-thickness table:get .dtable "w-thickness" ; The display area wall thickness
  let _w-color table:get .dtable "w-color" ; The wall color
  let _f-thickness table:get .dtable "f-thickness" ; The display area floor thickness
  let _f-color table:get .dtable "f-color" ; The floor color
    
  ; We need to make sure that regardless of world size and anchor points, all measurements calculated here are based on patch units.
  let _Ox min-pxcor + round ( ( max-pxcor - min-pxcor ) * _Ox% )
  let _Oy min-pycor + round ( ( max-pycor - min-pycor ) * _Oy% )
  let _width round ( world-width * _width% )
  let _height round ( world-height * _height% )
 
  dprint 3 "create-display" (word "Creating a new display area \"" _name "\" with origin at (" _Ox "," _Oy "), width=" _width " and height= " _height )
  
  ; First, let's make all these patches know that they belong to this display, and check for overlap
  let _a-patches no-patches
  let _overlap? false
  ask patches with [ pxcor >= _Ox and pycor >= _Oy and pxcor <= _Ox + _width and pycor <= _Oy + _height ]
  [
    ; If we are overlapping another area, we will find patches that already have a display-area variable set. Not a big deal, but track it.
    if ( ( not _overlap? ) and display-area != "" ) [ 
      set _overlap? true ; This is a trick to short-circuit this test once we have found even a single patch with overlap
      dprint 2 "create-display" (word "Overlapping display areas! At least one patch (" self ") was already assigned to display area " display-area )
    ]
    set display-area _name
    set patch-type "canvas"
    set pcolor _c-color
  ]
  set _a-patches patches with [ display-area = _name ]
  table:put .dtable "a-patches" _a-patches ; Store this patch-set in the table
    
  ; Build the borders    
  let _b-patches no-patches
  let _layer 0 
  repeat ( _b-thickness ) [
    set _Ox _Ox + _layer
    set _Oy _Oy + _layer
    set _width _width - 2 * _layer ; This is a trick to shrink the box in each direction by one unit at each iteration
    set _height _height - 2 * _layer ; This is a trick to shrink the box in each direction by one unit at each iteration
    ; we are going to ask patches within the border thickness to set their color to the b-color.
    ask _a-patches with [ (( pxcor = _Ox or pxcor = _Ox + _width) and ( pycor >= _Oy and pycor <= _Oy + _height )) or (( pxcor > _Ox and pxcor < _Ox + _width) and ( pycor = _Oy or pycor = _Oy + _height )) ] [
      set pcolor _b-color
      set patch-type "border"
    ]
    set _layer _layer + 1
  ]
  set _b-patches patches with [ patch-type = "border" ]
  table:put .dtable "b-patches" _b-patches ; Store this patch-set in the table

  ; Now we shrink the box again, this should match the inner space of the display area, so we can draw walls in the right place.
  set _Ox _Ox + _layer
  set _Oy _Oy + _layer
  set _width _width - 2 * _layer ; This is a trick to shrink the box in each direction by one unit at each iteration
  set _height _height - 2 * _layer ; This is a trick to shrink the box in each direction by one unit at each iteration
  
  ; Now let's do the walls
  let _w-patches no-patches
  set _layer 0 
  repeat ( _w-thickness ) [
    set _Ox _Ox + _layer ; With each cycle, shift the origin to the right by one patch
    set _width _width - 2 * _layer ; With each cycle, reduce the width by two patches (one for each side)
    ; we are going to ask patches within the border thickness to set their color to the w-color.
    ask _a-patches with [ ( pxcor = _Ox or pxcor = _Ox + _width) and ( pycor >= _Oy and pycor <= _Oy + _height ) ] [
      set pcolor _w-color
      set patch-type "wall"
    ]
    set _layer _layer + 1
  ]
  set _w-patches patches with [ patch-type = "wall" ]
  table:put .dtable "w-patches" _w-patches ; Store this patch-set in the table
  dprint 2 "create-display-new" (word "There are " count _w-patches " patches in the wall set.")

  ; Now we shrink the box again, this should match the inner space of the display area
  set _Ox _Ox + _layer
  set _width _width - 2 * _layer ; This is a trick to shrink the box in each direction by one unit at each iteration
  
  ; And now the floors. Notice that we store the Y offset and height as a list, even if there is only one level
  let _f-patches no-patches
  let _LOy [] ; Note: this is a list with as many items as there are levels
  let _Lh 0 ; We assume the height is the same for all levels.
  let _fh round ( _height / _levels ) ; Note that for now the height is constant for each floor, so we calculated this only once
  let _floor 0
  repeat ( _levels ) [
    let _f% ( _floor / _levels ) ; Get a number between 0 and 1 that represents the fraction of the whole height taken up by each floor
    let _fy ( _Oy + floor ( _floor * _fh ))
    
    ; To change the thickness we simply create as many one-patch floors as required.
    let _ft 0
    repeat ( _f-thickness )
    [
      ask _a-patches with [ patch-type = "canvas" and pycor = _fy + _ft]
      [
        set pcolor _f-color
        set patch-type "floor"
        set level _floor ; This may be needed if we ever do histograms
      ]    
      set _ft _ft + 1
    ]

    set _LOy lput ( _fy + _f-thickness ) _LOy
    set _Lh ( _fh - 2 * _f-thickness)
        
    ; Now set the level for space patches above you. Note that initially all space patches will be level 0, then as you move up, some will change.
    ask _a-patches with [ pycor >= _fy ] [ set level _floor ]
    
    set _floor _floor + 1
  ]
  set _f-patches patches with [ patch-type = "floor" ]
  table:put .dtable "f-patches" _f-patches ; Store this patch-set in the table
  dprint 2 "create-display-new" (word "There are " count _f-patches " patches in the floor set.")
  
  ; Add these absolute values to the table
  table:put .dtable "Ox" _Ox
  table:put .dtable "Oy" _LOy
  table:put .dtable "width" _width
  table:put .dtable "height" _Lh

  ; Put the list of Y offsets and widths for each level into the display table
  ;  table:put .dtable "levels-h" _Lh

  ; Now generate a label/title
  let _px max [ pxcor ] of _a-patches - ( 0.3 * _width )
  let _py max [ pycor ] of _a-patches - 3
  let _title-patch patch _px _py
  table:put .dtable "Title-patch" _title-patch  
  ask _title-patch [ set plabel-color _b-color ]
  
  ; Add min and max to right edge of plot
  table:put .dtable "Min-y-patch" patch ( _Ox - 2 ) _Oy
  table:put .dtable "Max-y-patch" patch ( _Ox - 2 ) ( _Oy + _height )
  table:put .dtable "Max-x-patch" patch ( _Ox + _width ) ( _Oy - 4 )  

end



;; ============= TRACKERS

;; Trackers areused to track specific variables from agents. It is a way of flexibly being able to
;; use different agent variables to determine what is shown in the display

; Setup procedure for trackers
to setup-trackers
  
  initialize-from-source "tracked-vars" ; Process the tracker vars from a csv file or PARAMS.nls (depending on whether web or not)
   
  foreach table:keys $#tracked-vars [ key -> initialize-trackers table:get $#tracked-vars key ] ; The table key is in the format varname+breed
  
  dprint 2 "setup-trackers" (word "Successfully read in the trackers information")
  
end


;; Do the step-by-step initialization of the trackers
to initialize-trackers [ .ttable ]
  ; Everything in this procedure is done once for each line read from the tracked-vars file.

  ; All max values are based on a 365-day span. Need to adjust accordingly based on sim-duration
  let _range-scale $sim-duration / 365 ;

  ; Need to calculate the range of each tracked var based on information passed in
  let _min ( table:get .ttable "min" ) * _range-scale
  let _max ( table:get .ttable "max" ) * _range-scale
  let _range _max - _min
  
  ; Now we need to put back the scaled values in the table
  table:put .ttable "min" _min
  table:put .ttable "max" _max
  table:put .ttable "range" _range
  
end

;; This procedure is invoked by the observer during initialization. It requires employees and companies to have been set up already
to initialize-display-trackers
  
  ; Need to initialize the #xy-commands table of every turtle to an empty table.
  ask turtles [ set #xy-commands table:make ]
      
  ; Configure the display variables
  ; Note: there may be multiple role types in the company.
  foreach table:keys $#employees [ c -> configure-display-vars c "employees" ]  

  ; Now turn on the employees that are going to be displayed, and put them in their initial position
  ask employees [
    ; We use a trick here: if the #xy-commands table is empty, it means there is no display for these agents - leave them hidden
    if table:length #xy-commands = 0 [ set hidden? true ]
    ; Move each employee to the correct starting position
    if (not hidden?) [ update-my-display ]
    
    ; See if they should leave a trace as they move
    ifelse ( $pen-down? and not hidden? ) [ pen-down ] [ pen-up ]              
  ]
  
  ; We comment out the following line because there is only ever one type of company - no sense of "roles" that require different plotting areas
  ; foreach table:keys $#companies [ c -> configure-display-vars c "companies" ]
  configure-display-vars "" "companies"
  
  ; Now turn on the companies that are going to be displayed, and put them in their initial position
  ask companies [                    
    ; We use a trick here: if the #xy-commands table is empty, it means there is no display for these agents - leave them hidden
    if table:length #xy-commands > 0 [ set hidden? false ]

    ; Move each company to the correct starting position
    if (not hidden?) [ update-my-display ]
    
    ; See if they should leave a trace as they move
    ifelse ( $pen-down? and not hidden? ) [ pen-down ] [ pen-up ]              
  ]

end


; This procedure use $#display to create a table with information about whether and where agents should be displayed.
to configure-display-vars [ .class .breed ]
  
  ; For employees, the .class variable is a compound of role+company, needs to be split out
  let _role .class  
  if ( .breed = "employees" )
  [  set _role item 1 ( string-to-list-of-strings .class "+" )   
    if ( [ table:length #xy-commands ] of one-of employees with [ role = _role ] ) > 0 [ 
      dprint 1 "configure-display-vars" (word "A display for employees of role " _role " already exists. Skipping." )
      stop ]
  ]
  
  ; Create a table for displaying variables that will be shared by all agents of this type
  let _#xy-commands table:make

  ; The table will contain a list, corresponding to the number of variables that will be displayed for this type of agent.
  foreach table:keys $#displays [ key -> 
    ; Use these local vars for some sanity checks and to create the agent display table(s)
    
    let _inner table:get $#displays key
    if ( table:get _inner "breed" = .breed ) ; Only process displays for our breed, otherwise this skips to the end.
    [
      
      let _da-type table:get _inner "format" ; This will be something like xy, ty, or bar
      let _da-role table:get _inner "role" ; Specifies the role of employees to whom this applies
      
      if ( _da-role = "*" or _da-role = _role ) ; Skip irrelevant rows
      [ 
        
        let _cvars table:get _inner "control-vars" ; This is the list of control variables found in the $#displays table
        let _ncvars length _cvars ; How many control variables
        let _num-levs table:get _inner "levels" ; See if this is a multi-level plot
        
        ; Check various conditions based on the plot type 
        (ifelse 
          _da-type = "xy" [
            ; XY-plots expect one variable for X and one for Y. Note that you can also $x-var and $y-var to set from the widget.
            if _ncvars != 2 [ dprint -1 "setup-display" (word "XY-type plots must specify two control variables." ) ]
        
            let _msg "Creating an X-Y chart "
            dprint 1 "setup-display" _msg

            
            ; Calculate the x variable range
            let _xpvar item 0 _cvars ; New version - do not look for reporters
            if ( item 0 _xpvar = "$" ) [ set _xpvar runresult _xpvar ] ; Allow entering a global variable such as "$x-var" as the interface-configurable var
            let _Ox table:get _inner "Ox" ; There should be a single value for the X axis offset
            let _inner-tvx table:get $#tracked-vars (word _xpvar "+" .breed) ; Need to modify the key when accessing the $#tacked-vars table
            let _xmin table:get _inner-tvx "min" ; Get the min value for X
            let _xmax table:get _inner-tvx "max"  ; Get the max value for X
            let _width table:get _inner "width" ; There should be a single value for the X axis width (range)
            let _xrange table:get _inner-tvx "range" ; Fetch the range of values for this var
            let _xscale _width / _xrange
            
            let _xcmd (word "[ -> " _Ox " + ( " _xpvar " - " _xmin " ) * " _xscale " ]" )            
            table:put _#xy-commands "x" runresult _xcmd
                        
            ; Calculate the y variable range
            let _ypvar item 1 _cvars ; New version - get the variable name (no reporters!)
            if ( item 0 _ypvar = "$" ) [ set _ypvar runresult _ypvar ] ; Allow entering "$x-var" or "$y-var" as the interface-configurable var
            let _Oy table:get _inner "Oy" ; This should be a list for the y axis offsets of each level
            let _inner-tvy table:get $#tracked-vars (word _ypvar "+" .breed) ; Need to modify the key when accessing the $#tacked-vars table
            let _ymin table:get _inner-tvy "min" ; Fetch the minimum y value
            let _ymax table:get _inner-tvy "max" ; Fetch the maximum y value
            let _height table:get _inner "height" ; Should be a list of y axis width (range) for each level
            let _yrange table:get _inner-tvy "range" ; Fetch the range of values for this var
            let _yscale _height / _yrange
            
            ; If this is a display for employees, need to deal with levels.
            ifelse ( .breed = "employees" ) [
              let _lvar table:get _inner "level-var" ; Need to know which variable controls the level, if any
              let _lvar-value table:get ( table:get $#employees .class ) _lvar
              if ( _lvar-value >= _num-levs )
              [ ; We will not display this agent because it has a level variable that is larger than the number of levels in the display
                set _lvar-value _num-levs - 1
                dmsg 1 "configure-display-vars" (word "Employees of type " .class " will be shown at level " _lvar-value )
              ]
              let _cmd (word "[ -> " item _lvar-value _Oy " + ( " _ypvar " - " _ymin " ) * " _yscale " ]" )            
              table:put _#xy-commands "y" runresult _cmd
            ]
            [
              ; For companies, there should only be a single level
              let _cmd (word "[ -> " item 0 _Oy " + ( " _ypvar " - " _ymin " ) * " _yscale " ]" )            
              table:put _#xy-commands "y" runresult _cmd
            ]
            
            ; Now set up the title, min and max markers
            ask table:get _inner "Title-patch" [
              set plabel (word .breed ": " table:get _inner-tvy "label" )
            ]
            ask table:get _inner "Min-y-patch" [
              set plabel currency "" _ymin
            ]
            ask table:get _inner "Max-y-patch" [
              set plabel currency "" _ymax
            ]
            
            ask table:get _inner "Max-x-patch" [
              set plabel round _xmax
            ]
            
          ]
          
          _da-type = "ty" [
            ; TY plots automatically place time (ticks) as the X axis, one or more variables on the Y axis
            ;          if _ncvars > 1 and _num-levs != _ncvars [
            ;            dprint -1 "setup-display" (word "For TY-type plots with multiple control variables, each level is one variable. Specify levels=" _ncvars " in the displays file.") ]
            ;          foreach table:keys (table:get _inner "control-vars") [ cvar ->
            ;            let _reporter table:get ( table:get _inner "control-vars" ) cvar
            ;            let _var-params table:get $#tracked-vars cvar
            ;            let _cv-min table:get _var-params "min"
            ;            let _cv-max table:get _var-params "max"
            ;            
            ;          ]
          ]
          
          ; Horizontal or vertical bar chart
          _da-type = "hbar" or _da-type = "vbar" [
            ; Horizontal bar chart
            let _msg "Creating a horizontal bar chart "
            dprint 1 "configure-display-vars" _msg
                        
            ; Figure out how many bars
            dprint 2 "configure-display-vars" (word "Found the following control variables: " _cvars )
            
            ; Extract parameters need to figure out the scaling factor for all bars
            let _Ox table:get _inner "Ox" ; There should be a single value for the X axis offset
            let _Oy table:get _inner "Oy" ; There should be a single value for the Y axis offset            
            if is-list? _Oy [ set _Oy first _Oy ] ; Check to make sure it's a single value
            
            ; First, pull out the dimensions in which the charts are organized. We define chart-area-width and chart-area-height depending on the orientation
            let _ca-width table:get _inner ( ifelse-value ( _da-type = "hbar" ) [ "height" ] [ "width" ] ) ; For h bars, the "width" is the vertical axis of the display, and v.v.
            let _ca-height table:get _inner ( ifelse-value ( _da-type = "hbar" ) [ "width" ] [ "height" ] ) ; For h bars, the "height" is how far the bars can grow, and v.v.            

            ; These may need to be moved out to the display csv, for now set them here to determine the spacings between bars and blocks
            let _pad-ratio 1.5 ; Size of padding between groups bars of different variables, relative to bar width (also at either side of the window)
            let _gap-ratio 0.2 ; Size of gap between bars of same variable, relative to bar width           
            let _ncos count (companies) ; How many companies
            ; The following equation calculates the thickness of each bar in a multi-bar chart in a window. Works for either horizontal or vertical bars
            ; PG note: the check-bounds upper limit should equal the thickest bar available in the shapes library
            let _bar-thickness check-bounds ( round ( _ca-width / ( _ncos * _ncvars + ( _ncos - 1 ) * _ncvars * ( 1 + _gap-ratio ) + ( _ncvars - 1 ) * ( 1 + _pad-ratio ) ) ) ) 1 5            
            let _cb-width floor ( ( _ca-width + _pad-ratio * _bar-thickness ) / _ncvars ) ; Calculate the width of each chart block (the bars for all companies shown for each control variable)

            dprint 3 "configure-display-vars" (word "Setting up a bar chart. W=" _ca-width ", H=" _ca-height ", bar-thickness=" _bar-thickness ", _cb-width=" _cb-width )

            
            ; Create the bar agents for each company
            let _ncvar 0
            foreach _cvars [ _cv -> 
              let _inner-tvx table:get $#tracked-vars (word _cv "+" .breed) ; Need to modify the key when accessing the $#tracked-vars table
;                let _min table:get _inner-tvx "min" ; Get the min value for the control variable
;                let _max table:get _inner-tvx "max"  ; Get the max value for the control variable
              let _range table:get _inner-tvx "range" ; Fetch the range of values for this var
                
              ask companies [
                hatch-bars 1 [
                  set hidden? true
                  set my-parent myself ; Who is my parent?
                  ask my-parent [ set my-bars (turtle-set my-bars myself ) ] ; Add myself to may parent's set of bar agents
                  set my-block _ncvar; 
                  set my-number [ my-number ] of my-parent                   
                  
                  set p-var _cv ; Which variable we are tracking
                  set my-factor _range / 80 ; Used to calculate the rigth size during display updates - note setting this to 80 means the bars will only reach 80% of the width.
                  set my-units table:get _inner-tvx "units"
                  
                  set bar-thickness _bar-thickness
                  set shape ( word substring _da-type 0 2 bar-thickness "-" 0 ) ; Start with a zero bar
;                  set label ( word my-block "." my-number )
                  set size _ca-height
                  
                  ifelse ( _da-type = "hbar" ) [
                    setxy ( _Ox + size / 2 )  ( _Oy + size / 2 + 1 ) + ( my-block * _cb-width ) + bar-thickness * ( 2 + _gap-ratio ) * my-number
                    if ( my-number = 0 ) [ ; Set a label but only for the first company to avoid duplication.
                      let _left-offset ifelse-value (netlogo-web?) [ 15 ] [ 5 ]
                      ask patch ( _Ox - _left-offset ) ( _Oy + my-block * _cb-width + bar-thickness ) [ set plabel table:get _inner-tvx "label" ]
                    ]
                  ]
                  [
                    set xcor _Ox; - size / 2 ;  + ( my-block * _cb-width ) + ( ( 2 + _gap-ratio ) * bar-thickness * my-number ) ) 
                    set ycor _Oy + size / 2
                  ]                    
                  
                  set hidden? false
                ]
              ]
              set _ncvar _ncvar + 1
            ]
            
          ]
          
          ; No match
          [
            dprint -1 "configure-display-vars" (word "Display format " _da-type " not recognized.")
          ]

        )
        ; Now copy this information to all employees of this type
        (ifelse 
          ( .breed = "employees" ) [ ask employees with [ role = _role ] [ set #xy-commands _#xy-commands ] ]
          ( .breed = "companies" ) [ ask companies [ set #xy-commands _#xy-commands ] ]
          [ dprint -1 "configure-display-vars" (word "Something wrong: trying to set displat vars for breed " .breed ) ]
        )
      ]
    ] ; End of ifelse that skips here if the display line is not related to the breed.
  ] 
  
end


;; Invoked from the GO loop to update visible agents
to update-display
  ask companies [ 
    
    ; Always update the employees' tracked vars
    if $track-vars? [
      ask my-employees [ update-tracked-vars ]
    ]
    
    ; Choose whether to display individual or average employees
    ifelse ( average-employee? ) 
    [
      ; Update and display the average employees
      ask my-average-employees [
        update-average-employee-stats
        if (not hidden?) [ update-my-display ]
      ]
    ]
    [
        ; Display the individual employees
        ask my-employees [ 
        if (not hidden?) [ update-my-display ]
        ]
    ]
    
    ; Update my own tracked variables
    if $track-vars? [ update-tracked-vars ]
    if (not hidden?) [ update-my-display ]
  ]
end



;; Calculate the updated position of each agent for the displays
to update-my-display
  
  if table:length #xy-commands > 0 [
    let _x runresult table:get #xy-commands "x"
    let _y runresult table:get #xy-commands "y"
    setxy _x _y
    ; update-sprite my-sprite
  ]
  
end


; Update the bar charts
to update-bar-charts
;  ask $display-patch [ set plabel $total-tasks-completed ]
;  let _val ( floor ( ( 0.0125 * $total-tasks-completed + 2 ) / 5 ) * 5 )
;  let _val floor ( check-bounds ( ticks / 3 ) 0 100 )
;  ask bars [ set shape (word "hb" ( round check-bounds bar-thickness 1 8 ) "-" _val ) ]

ask bars [  
    let _my-val last ( table:get ( table:get #tracked-vars p-var ) "value" )
    let _label ifelse-value ( my-units = "$" ) [ (word currency my-units ( round _my-val ) ) ] [ (word round _my-val my-units )] 
    if netlogo-web? [ set _label (word _label "      ") ]
    set label _label
    set _my-val check-bounds round ( _my-val / my-factor ) 0 100
    set shape (word "hb" bar-thickness "-" _my-val)
  ]

end


;; Update all the employee variable trackers
; This procedure adds the current value of a variable to a list of the values of this variable at each time step
; The #tracked-vars table has actual variable names as the key, e.g., "satisfaction". The names have to be the actual variable name for this to work
; Any function that needs to fetch a variable's value can just pull out an item from the list
to update-tracked-vars
  foreach table:keys #tracked-vars [ vname -> 
    let _inner table:get #tracked-vars vname
    ; Only store value for vars that are listed as trackable
    if table:get _inner "tracked?" [
      let _vlist  table:get _inner "value"; Fetch the list of values for variable 'vname'
      set _vlist lput clean-number (runresult vname) 2 _vlist ; Add the current value to the end of the list. Note that vname has to be the variable name
      table:put _inner "value" _vlist ; Update the table
    ]
  ]
end


; Calculate averages across employees
to update-average-employee-stats
  ; Note: since we are not tracking variables, we don't need anything other than the current tracked var name
  run (word "set " $employee-display-var " mean [ " $employee-display-var " ] of tracked-colleagues ") ; Calculate the mean

end




;; ----- merged from Includes/EMPLOYEES.nls -----
;;
;; ================================ EMPLOYEES.nls =============================
;;

;; --------- Employee initialization and updates

; Set up the employees
to setup-employees
    
  ; Initialize the roles from a csv-like parameter set in PARAMS.nls
  initialize-from-source "employees"
  
  foreach table:keys $#employees [ c -> create-new-employees c ( table:get ( table:get $#employees c ) "number" ) ]  
  
  ; Match up employees and companies - Notice this needs to happen here
  ask companies [
    let _my-name name
    let _my-who who
    set my-employees employees with [ my-company-name = _my-name and ( not average? ) ]
    let _my-employees my-employees
    dprint 2 "setup-employees" (word "Company " name " has " count my-employees " employees.")
    ask my-employees [ 
      set my-company myself
      set my-number ( max [ my-number ] of _my-employees ) + 1 ; This assigns employee numbers for each company
      set color [ color ] of myself ; NOTE: This will force employees to have the same color as the company for which they work
      set satisfaction 0.9 * [ job-quality ] of myself ; Initial employee satisfaction level is based on job quality of company - assume current max is 0.9 CZ CHECK
    ]
    set num-employees count my-employees
    
    ; If tracking only the average employee, do that here.
    if average-employee? [
      set my-average-employees employees with [ my-company-name = _my-name and ( average? ) ]
      ask my-average-employees [
        set my-company myself
        set color [ color ] of myself ; NOTE: This will force employees to have the same color as the company for which they work
;        set size size * 1.5 ; Make it bigger!
      ]      
    ]
  ]
  
  set $average-employees employees with [ average? ]
                  
end

;; This procedure creates N employees of a certain role
to create-new-employees [ .class .num ]
  
  ; This is a cheap hack to allow reduction by one employee for one of the scenarios
  
  create-employees .num [
    
    ; Start with setting some basic characteristics for the employee's roles
    set-employee-params .class
    
    ; Create a table of trackers and initialize all agent variables being tracked
    init-tracked-vars
    
    ; Create a "sprite" to show some aspect of each employee.
    ;    make-my-sprite

  ]
  
  ; Now create an extra employee to track average values for this class, if required
  if average-employee? [
    create-employees 1 [
      ; Start with setting some basic characteristics for the employee's roles
      ; set-role-params .class
      
      ; Create a table of trackers and initialize all agent variables being tracked
      ;init-tracked-vars
      
      set average? true
      set class .class
      set #role-params table:get $#employees .class ; Pull out the "inner" table of role parameters for this specific type of employee
      set role table:get #role-params "role"
      set my-company-name table:get #role-params "company"
      set rank table:get #role-params "rank"
      ; set color table:get #role-params "color" ; This command is overridden just above where it is set to be the company color
      set size 1.5 * table:get #role-params "size" ; Make this one bigger as it is the average
      set shape table:get #role-params "shape";  
      set class .class
      let _my-class class
      let _my-company my-company
      set tracked-colleagues employees with [ class = _my-class and my-company = _my-company and not average? ]
      ; Create a "sprite" to show some aspect of each employee.
      ;    make-my-sprite
    ]
  ]
      
end


;; Set some of the (fixed) role parameters for the employee
to set-employee-params [ .class ]
  set average? false
  if average-employee? [ set hidden? true ] ; Hide the individual employees if using the average only
  set class .class
  set #role-params table:get $#employees .class ; Pull out the "inner" table of role parameters for this specific type of employee
  set role table:get #role-params "role"
  set my-company-name table:get #role-params "company"
  set rank table:get #role-params "rank"
  ; set color table:get #role-params "color" ; This command is overridden just above where it is set to be the company color
  set size table:get #role-params "size" ; We'll need to scale the employee size based on number of levels
  set shape table:get #role-params "shape";  
  set schedule-type table:get #role-params "schedule"
  set max-hours table:get #role-params "max-hours"
  set min-hours table:get #role-params "min-hours"
  ; A cheap hack to lower the min guaranteed hours by a certain about if the scenario variable $minimum-hours is set to false
  ; if ( ( not $minimum-hours? ) and my-company-name = "Fashion2" ) [ set min-hours min-hours - 1 ]
  if ( ( not $minimum-hours? ) and my-company-name = "Fashion2" ) [ set min-hours 2 ]
  
  set skill-level round runresult ( table:get #role-params "skill-level" )
  set tardy-rate table:get #role-params "tardy-rate"
  set absent-rate table:get #role-params "absent-rate"
  set pay-amount table:get #role-params "pay-amount" 
  ; A cheap hack to lower the pay rate by a certain about if the scenario variable $lower-pay is set to false
  if ( ( not $better-pay? ) and my-company-name = "Fashion2" ) [ set pay-amount precision ( pay-amount * 0.9 ) 2 ]
  
  set daily-activities [] ; Initialize a list that tracks the employee's day-to-day perfomance for the entire simulations
  set all-activities [] ; This is a running list of all activities across all days
  set #daily-events table:make ; Create the table of my daily events


end


;; Initialize the table of tracked variables (can be for any breed)
to init-tracked-vars
  set #tracked-vars table:make ; This is the local table of all variables being tracked for this type of agent. Each key will be an agent variable name.
;  if ( not $track-vars? or netlogo-web? ) [ stop ] ; Skip this if var tracking is turned off or if running inside netlogoweb
  if ( not $track-vars? ) [ stop ] ; Skip this if var tracking is turned off (but run even if invoked from netlogoweb)
  foreach table:keys $#tracked-vars [ key ->
    let _vartable table:get $#tracked-vars key
    let _varname item 0 ( string-to-list-of-strings key "+" ) ; The table key is in the format varname+breed
    
    if ( (table:get _vartable "breed" = (word breed)) and ( table:get _vartable "tracked?" ) ); Only grab variables for my breed. Note you have to use "word" to turn the breed to a string
      [
        let _vtable copy-table _vartable ; Note: this copies the entire table, which includes unnecessary info like the variable name and breed. Remove them.
        ; The reason we do it this way is so that in the future if we add more columns to the trackers file, they will automatically appear here.
        table:remove _vtable "name"
        table:remove _vtable "breed"
        table:remove _vtable "init"
        
        ; Initialize the tracked variable by evaluating the expression found in the "init". 
        ; "key" is the name of the agent's variable that is being tracked
        ; In order for the following command to work, "init" must be an expression that can be evaluated with runresult
        ; let _init runresult ( table:get _vartable "init" )
        let _init table:get _vartable "init"
        if ( _varname != "ticks" ) [
          run (word "set " _varname " " _init)
        ]
        table:put _vtable "value" (list runresult _varname ) ; Note that "runresult _varname" returns the value of the variable we just set.
        
        ; Now add this row to the agent's #tracked-vars table
        table:put #tracked-vars (table:get _vartable "name") _vtable
    ]
  ]
end


; ------ Employee variable updaters
; These are the reporters passed as anonymous reporters when individual variables are added to $#e-vars (see initialize-e-vars in the main file)

; Satisfaction
to update-satisfaction 
  set satisfaction ( check-bounds ( satisfaction + ( ( random 201 ) - 100 ) / 10000 ) 0.0 1.0 ) ; For now it's randomly fluctuating around a constant
  ; set satisfaction ( check-bounds ( satisfaction + 0.01 ) 0.0 1.0 ) ; For now it's randomly fluctuating around a constant
end


;; ==================== TASKS / ACTIVITIES PROCEDURES

;; -------- Employee activities / procedures

;; Actitivities at the start of the day
to start-my-day

  ; Reset the list of daily activities
  set daily-activities []
  
  ; Reset the variables that may be tracked
  set daily-hours-scheduled 0
  set daily-tardy-time 0
  set daily-hours-worked 0
  set daily-customers-helped 0
  set daily-sales-closed 0
  set daily-tasks-failed 0
  set daily-productivity 0
  set daily-misc-task-time 0
  set daily-idle-time 0
  set daily-rest-time 0
  set daily-earnings 0
  set daily-revenues 0
  
  set #daily-events table:make ; Create the table of my daily events
  
  ; Now set other variables and flags used during the day
  set my-next-activity ""
  set absent? false
  set brake-taken? false
    
  ; Check if we actually showed up for work today
  ifelse ( absent-today? ) [
    set absent? true
    add-activity (word "did not show up for work today! ")
    set absent-counter absent-counter + 1
    end-my-day
  ]
  [
    ; Not absent, set the actual arrival time
    set-todays-schedule
    
    add-activity (word "Starting shift at " clock-time start-time ", working " daily-hours-scheduled "hrs until " clock-time end-time )
    dprint 3 "start-my-day" (word who-when "Starting shift at " clock-time start-time ", working " daily-hours-scheduled "hrs until " clock-time end-time )
    
    set working? true
    schedule-my-event [ -> next-activity ] start-time + idle-time

  ]
  
end

;; Activities at the end of the day
to end-my-day
  
  ; Tally up your various variables
  update-satisfaction
  set daily-earnings daily-hours-worked * pay-amount

  set total-hours-scheduled total-hours-scheduled + daily-hours-scheduled
  set total-tardy-time total-tardy-time + daily-tardy-time
  set total-hours-worked total-hours-worked + daily-hours-worked
  set total-customers-helped total-customers-helped + daily-customers-helped
  set total-sales-closed total-sales-closed + daily-sales-closed
  set total-tasks-failed total-tasks-failed + daily-tasks-failed 
  set total-productivity total-productivity + daily-productivity
  set total-misc-task-time total-misc-task-time + daily-misc-task-time
  set total-idle-time total-idle-time + daily-idle-time
  set total-rest-time total-rest-time + daily-rest-time
  set total-earnings total-earnings + daily-earnings
  set total-revenues total-revenues + daily-revenues
  
  ; Update the overall activity list
  if ( $debug-level > 3 ) [
    set all-activities lput (sentence daily-activities) all-activities
  ]
  
  set working? false

end


;; Set the schedule for the day
to set-todays-schedule
  ; Note: in the future we should create a centralized scheduler that sets everyone's schedule to ensure there are no gaps!
  
  ; First, figure out how many hours you are working today. Note that we do this here in case in a later version these quantities vary daily
  let _c-SOB [ SOB ] of my-company
  let _c-EOB [ EOB ] of my-company
  let _c-daily-minutes _c-EOB - _c-SOB 
  let _c-daily-hours round ( _c-daily-minutes / $es-ticks-per-hour )
  
  ; Now we set the start and end time based on the schedule type
  ( ifelse 
    schedule-type = "var" [    
      set daily-hours-scheduled precision ( ( random-float ( max-hours - min-hours ) ) + min-hours ) 1 ; Pulls a number between min and max hours worked
      ; Now set the start time to a random range such that you will end by closing time for sure.
      let _st random-float (_c-daily-hours - daily-hours-scheduled ) ; Given our scheduled hours and the length of a day, pick a random start time that fits.
      set start-time _c-SOB + floor ( _st * $es-ticks-per-hour )
      ; Now set the quitting time
      set end-time floor ( start-time + ( daily-hours-scheduled * $es-ticks-per-hour ) )
    ]
    schedule-type = "cover" [    
      set daily-hours-scheduled precision ( ( random-float ( max-hours - min-hours ) ) + min-hours ) 1 ; Pulls a number between min and max hours worked
      let _daily-minutes floor ( daily-hours-scheduled * $es-ticks-per-hour )
      ; Now set the start time to the earliest time where there is a gap
      let _coverage but-last ( table:values [ #daily-coverage ] of my-company ) ; Note: the last item in the table often stays at 0 which messes up the calculation, so skip the EOB slot
      let _min-coverage min _coverage
      set start-time position _min-coverage _coverage + _c-SOB
      if ( start-time + _daily-minutes > _c-EOB ) [ set start-time _c-EOB - _daily-minutes ]
      ; Now set the quitting time
      set end-time start-time + _daily-minutes
      dprint 2 "set-todays-schedule:cover" (word who-when "plans to start at " start-time " and end at " end-time)
    ]
    schedule-type = "fixed" [
      set daily-hours-scheduled precision ( max-hours - min-hours ) 1
      set start-time _c-SOB + floor $es-ticks-per-hour * ( min-hours - _c-SOB )
      ; Now set the quitting time (note: in principle could do this outside ifelse, but someday there may be a reason to specify different end-time algorithms...
      set end-time floor ( start-time + ( daily-hours-scheduled * $es-ticks-per-hour ) )
  ]
    ; Uh-oh, we don't recognize the schedule type.
    [ dprint -1 "set-todays-schedule" (word who-when "While setting up " role " got unrecognized work schedule type " schedule-type ". Check $employees-params in PARAMS.nls" ) ]
    )
    
  ; Check if you are tardy-amount and adjust start and end times accordingly
  if ( tardy-today? ) 
  [ 
    set tardy-counter tardy-counter + 1 ; Increment the tardy-amount counter
    set daily-tardy-time floor ( (random-float 90) * (1 - satisfaction) + 15 ) ; For now we choose a random tardy amount between 15 and 60 minutes, influenced by satisfaction
    set start-time start-time + daily-tardy-time
    ; Will the tardy employee stay later to fulfill the number of scheduled hours, or simply cut their day short?
    ifelse $make-up-for-tardy? [
      set end-time end-time + daily-tardy-time
      ; Need to make sure we are not keeping you past closing time
      if (end-time > [ EOB ] of my-company ) [ set end-time [ EOB ] of my-company ]
      dprint 1 "set-todays-schedule" (word who-when " arrived at work " daily-tardy-time " minutes late. Shifting end time to " clock-time end-time )
    ]
    [
      dprint 1 "set-todays-schedule" (word who-when " arrived at work " daily-tardy-time " minutes late. Will not make up for tardiness, still quitting at " clock-time end-time )
    ]
  ]
  
  ; Calculate the (estimated) amount of hours worked today, including tardy amounts.
  set daily-hours-worked precision ( ( end-time - start-time ) / 60 ) 2
  
  ; add-activity (word "Starting at: " ( clock-time start-time ) " (" tardy-amount "min tardy). Scheduled end at " ( clock-time end-time) )
  
  ; Need to create local copies of my vars to pass to the company
  let _st start-time
  let _et end-time
  let _who who
  
  ask my-company [ add-to-coverage _who _st _et ] ; Update coverage based on your actual arrival time.
      
end


;; Decide what to do next
to next-activity 
  ; Here we should check for things like break, lunch, personal stuff, then decide on the next task
  
  ifelse time-to-quit? [
    add-activity (word "Quitting for the day at " clock-time $es-daily-time )
    set working? false
    stop
  ]
  [ ; Not time to quit
    ifelse time-to-break? [
      take-a-break
      stop
    ]
    [ ; Not time to take a break
      ; Time to fetch a task
      do-next-task
    ]
  ]
  
end


; Check if there is enough time to do the task before the end of day
to do-next-task

  ; Fetch the list of tasks
  let _task-list table:get $#company-tasks class
  
  let _type ""
  
  ; If there are no revenue-generating tasks, look for misc tasks 
  if length _task-list < 1 [
    
    ; We will try to do a misc task if one is available
    let _misc-task-list [ daily-misc-tasks-list ] of my-company ; Fetch a misc task from the company's daily list
    
    ; If the company is running out of tasks, ask it to make more!
    if ( length _misc-task-list < 1 ) [
      ask my-company [ create-daily-misc-tasks-list ]
      set _misc-task-list [ daily-misc-tasks-list ] of my-company ; Fetch a misc task from the company's daily list
      dprint 3 "do-next-task" (word who-when "is asking its company to create more misc tasks.")
    ]
    ; Go through the list until you find one that you can do before quitting
    let _found-doable-task? false
    let _i 0
    
    while [ not _found-doable-task? and _i < length _misc-task-list ] [
      let _tsk item _i _misc-task-list
      let _name item 0 _tsk ; Get the task name
      let _effort ifelse-value ( _name = "Idle" ) [ idle-time ] [ round ( actual-effort item 1 _tsk ) ] ; Estimate the actual effort or idle time
      let _rest ifelse-value ( _name = "Idle" ) [ 0 ] [ rest-time _effort ] ; Estimate the amount of rest time needed, unless the task is "Idle"
      
      ; Check if we can finish at least one minute before the end of our day, otherwise look for another one.
      ifelse ( $es-daily-time + _effort + _rest + 1 < end-time ) [
        ; NOTE: we are using a sample-without-replacement strategy in choosing random tasks
        ask my-company [ set daily-misc-tasks-list remove-item _i _misc-task-list ] ; Remove this task from the company's dailly list
        let _next-task-time $es-daily-time + _effort + _rest ; The next activity will come after this activity plus the rest time.
        add-activity (word "Started task " _name ". Will look for my next task in " ( _effort + _rest ) " minutes.") ; Make a note of this activity
        schedule-my-event [ -> next-activity ] _next-task-time ; Schedule your next activity
        ifelse ( _name = "Idle" ) [
          set daily-idle-time daily-idle-time + _effort ; If it's idle, there is no rest time
        ]
        [
          set daily-misc-task-time daily-misc-task-time + _effort ; Update the misc-tasks time
          set daily-rest-time daily-rest-time + _rest ; Update the rest time
        ]
        
        set _found-doable-task? true
      ]
      [
        ; This task is not feasible, try the next one
        set _i _i + 1
      ]
    ]
    
    ; Now check if we failed to find any tasks. This may happen toward the end of the day if none of the tasks left in the list are short enough. In this case fall back on Idle time
    if not _found-doable-task? [
      let _idle idle-time
      add-activity (word "None of the MISC tasks in the queue is short enough to complete. Waiting until " clock-time ( $es-daily-time + _idle )  " (" _idle "min) before trying again." )
      schedule-my-event [ -> next-activity ] ( $es-daily-time + _idle ); Schedule the next activity
    ]
    stop
  ]
  
  let _found-doable-task? false
  let _i 0
  
  ; As long as there are items in the task list, keep checking until you find one that is not too long
  while [ _found-doable-task? = false and _i < length _task-list ] [
    let _task item _i _task-list
    let _effort round ( actual-effort (item 2 _task)) ; The actual effort is influenced by the level of satisaction
    ifelse ( end-time - $es-daily-time >= ( _effort + 2 ) ) ; See if we have enough time, with a small buffer to avoid overlapping events
    [ ; Found one!
      ; To avoid race conditions, check to make sure someone else is not trying to grab it at the same time
      set current-task _task
      let _task-agent (item 0 current-task)
      let _completion-time $es-daily-time + _effort      
      
      ifelse [ not started? ] of _task-agent [
        ; If we get here, it means we are good to go!
        
        ; Remove this task from the list
        table:put $#company-tasks class remove _task _task-list

        ; Grab the correct task agent
        ask _task-agent [
          set my-employee myself
          set started? true
          set completion-time _completion-time
        ]
        ; Grab the type of task (e.g., "customer" or "open")
        set _type (item 3 current-task)
        add-activity (word "Started a " _type " task, will take " _effort " minutes")
                
        set _found-doable-task? true
        set daily-customers-helped daily-customers-helped + 1
        
        ; Now schedule your next activity to be the completion of the task
        schedule-my-event [ -> complete-my-task _task-agent _effort ] _completion-time
        
      ]
      [ ; If we get here it means someone else had already grabbed this task before we could! Should not happen...
        dprint -1 "do-next-task" (word who-when "Race condition: task " _task " was still on the list, but already started by " [ my-employee ] of _task-agent )
        set _i _i + 1 ; Make sure you go to the next task
        stop
      ]
      
    ]
    [ 
      ; We did not find a doable task, increment the counter and check the next one on the list.
      add-activity (word "Task " _i " on the list would take me too long (" _effort "min). Looking for another task in the queue." )
      set _i _i + 1
    ]
  ]
    
  ; If we get here and no tasks are found, wait a bit and then try again
  if not _found-doable-task? [
    let _idle idle-time
    add-activity (word "All the tasks in the queue are too long! Waiting " _idle " minutes before trying again." )
    schedule-my-event [ -> next-activity ] $es-daily-time + _idle; Schedule the next activity

    stop
  ]
      
end


;; The employee has completed a task. Tell the task agent to wrap it up, then wait a short bit and do your next task
to complete-my-task [ .task-agent .effort ]
  
  set daily-productivity daily-productivity + .effort
  let _value 0; [ value ] of .task-agent
  let _prob-success 0 ; [ prob-success ] of .task-agent
  let _task-ID [ who ] of .task-agent
        
  ; Now get the task agent to close down the task.
  ask .task-agent [ ; Now tell the agent that the task is done!
    set completed? true
    set _value my-value ; Fetch the baseline value of this task
    set _prob-success prob-success ; Fetch the baseline probability of success
    complete-task
  ]
  
  ; Now calculate the actual value generated based on probability of success and work quality (which depends on satisfaction)
  set _value actual-value _value _prob-success
  ifelse ( _value > 0 ) ; Only increment counter for successfully completed tasks!
  [    
    set daily-sales-closed daily-sales-closed + 1 ; Note - for now all tasks get completed, though not all are successful (see below for failed tasks)
    set daily-revenues daily-revenues + _value ; Keep track of revenues generated
  ]
  [
    set daily-tasks-failed daily-tasks-failed  + 1 ; Increment the failed tasks counter
  ]

  ; Take a short break proportional to the effort you spent on it regardless of the success or failure
  let _rest rest-time .effort
  let _next-task-time $es-daily-time + _rest;
  set daily-rest-time daily-rest-time + _rest
      
  schedule-my-event [ -> next-activity ] _next-task-time ; Schedule your next activity
  
  ifelse ( _value > 0 ) [
    add-activity (word "Completed sale, generated $" _value ". Taking a " _rest "-min rest before next task.")
  ]
  [
    add-activity (word "Customer did not make a purchase. Taking a " _rest "-min rest before next task.")
  ]

end


;; Take a break and schedule the next task
to take-a-break
  ; CZ: this is influenced by satisfaction

  set working? false
  ; In the current formulation the break is between 25 minutes (when satisfaction = 1) and 35 minutes (when satisfaction = 0)
  let _duration floor ( 25 + 10 * (1 - satisfaction) ) ; Random break, influenced by satisfaction.
  
  ; Check if the break will take me beyond the end of day
  if ( $es-daily-time + _duration + 1 >= end-time ) [
    set _duration end-time - $es-daily-time - 2 ; Cut the break short.
  ]
  
  add-activity (word "Taking a " _duration "-min break." )
  
  ; Update the coverage table of your company
  let _st $es-daily-time ; Time when break starts
  let _et _st + _duration ; Time when break ends
  let _who who  
  ask my-company [ reduce-coverage _who _st _et ]
  
  ; Here we assume that a break counts as idle time. Could change it to be removed from payable time.
  set daily-idle-time daily-idle-time + _duration
  
  ; Lok for the next activity when your break is over.
  schedule-my-event [ -> end-break ] ( $es-daily-time + _duration ) 
end

;; End your break
to end-break
  set working? true
  add-activity (word who-when "Returning to work from break" )
  
  schedule-my-event [ -> next-activity ] $es-daily-time + 1
end


;; Add an activity to the daily list of activities
to add-activity [ .activity ]
;  set daily-activities lput (word who-when .activity ) daily-activities
  ; Try a more pithy version
    set daily-activities lput (word ( clock-time $es-daily-time ) " " .activity ) daily-activities
end  


;; Calculate an amount of idle time beore the next task is picked up
to-report idle-time
  ; CZ this is influenced by level of satisfaction
  
  ; Generate a random delay based on a fixed exponential distribution, then add a term due to satisfaction
  ; Current version will generate a minimum of 2 min (when satisfaction = 1) and a maximum of 7 (when satisfaction = 0).
  let _idle floor ((random-exponential 2) * (1 - satisfaction)) + 2 ; Always make sure it is >= 2 or it could mess up the event handler!
  
  ; If idle time would push beyond end of day, just make it one minute prior to the end of day.
  if ( $es-daily-time + _idle >= end-time ) 
  [ set _idle ( end-time - $es-daily-time - 1 ) ]

  ; Update the daily stats
  set daily-idle-time daily-idle-time + _idle
  
  if _idle < 0 [ dprint -1 "idle-time" (word who-when "has just done negative idle time!") ]
  
  report _idle
end


;; Calculate the amount of break taken after each task is completed.
to-report rest-time [ .effort ]
  ; CZ this is influenced by level of satisfaction
  
  ; We assume that the rest time is a minimum of 2 minutes, plus a random amount up to 10% of the effort, and influenced by satisfaction
  let _rest-time round ( ( random-exponential ( .effort / 10 ) ) * (1 - satisfaction) ) + 2 ;
  
  ; Check to make sure the rest time does not take us to or beyond the end of the day (actually 1 minut prior to end of day to avoid conflict with the end-of-day event.
  if ( $es-daily-time + _rest-time >= end-time ) 
  [ set _rest-time ( end-time - $es-daily-time - 1 ) ]
  
  report _rest-time
end
  

;; Check if it's time to quit
to-report time-to-quit?
  ; Rule of thumb: it we are very close to the end of the day, just quit.
  ifelse ( end-time - $es-daily-time < 5 ) ; Assume 5 minutes, but it could be less, or it could be influenced by satisfaction
  [ 
    if ( $es-daily-time >= end-time ) [
      dprint -1 "time-to-quit" (word who-when "is ending their day at or after closing time!")
    ]
    set daily-idle-time daily-idle-time + (end-time - $es-daily-time); Track the idle time at the end of the day.
    report true 
  ] 
  [ report false ]
end


;; Check if it's time to take a break
to-report time-to-break?
  ; We take a break if (1) a break has not been taken yet, (2) today we are working at least 4 hours, (3) the half-way mark of our day has passed.
  ifelse ( ( not brake-taken? ) and ( daily-hours-worked > 4 ) and ( $es-daily-time - start-time ) > ( daily-hours-worked * 60 / 2 ))
  [ 
    ifelse ( [ table:get #daily-coverage clock-time $es-daily-time ] of my-company > 0 ) [ ; Check to make sure you are not the only staff member
      set brake-taken? true
      report true 
    ]
    [ ; Nobody else around, need to postpone break
      print (word who-when "wanted to take a break but nobody else seems to be around...")
      ; CZ: Here we could decrease satisfaction slightly.
      report false
    ]
  ]
  [
    report false
  ]
end


; Calculate the actual effort spent on a task
to-report actual-effort [ .effort ]
  ; We use a gamma distribution to estimate the actual time taken to complete the task.
  ; The values used here were determined empirically. The idea is that the less satisfied you are, the lazier, the longer it takes you to complete the task
  ; Also, the gamma distro is adjusted to account for the baseline length of time - the longer the baseline, the larger the spread.
  let _alpha 0.3 + (1 -  satisfaction) * .effort * 1.4
  let _lambda 1.5 ; This determines the shape of the Gamma distribution. Found this empirically good for satisfaction between 0 and 1
  let _offset 0.95 * .effort
  report _offset + random-gamma _alpha _lambda
end


; Calculate the actual value generated from a task
to-report actual-value [ .value .prob ]
 
  ifelse (( random-float 1.0 ) < .prob)
  [
    ; Success!
    report round ( .value * my-work-quality ) ; Depends on my skills as a salesperson
  ]
  [
    ; Did not succeed    
    
    ; Let the company know that the task was not successful.
    ask my-company [
      set daily-tasks-failed daily-tasks-failed + 1
    ]

    ; Customer left without purchasing anything.
    report round 0.0
    
  ]
end


; Calculate the work quality depending on the employee's satisfaction etc.
to-report my-work-quality
  ; For now, for simplicity, we assume a linear relationship of the form [min + (max - min)*satisfaction].
  ; As satisfaction ranges from 0 to 1, work quality ranges from min to max.
  ; If min = 2*(max-min), an average level of satisfaction (0.5) leads to a work quality of 1
  report 0.9 + 0.2 * satisfaction
end


;; Check if someone is going to be absent today
to-report absent-today?
  ; CZ this is influenced by your level of satisfaction  
  
  ; The absenteeism ranges between 0 and absent-rate depending on satisfaction
  report ( ifelse-value ( random-float 100 > (absent-rate * (1 - satisfaction))) [ false ] [ true ] )
end


;; Calculate the amount of tardy time
to-report tardy-today?
  report ( ifelse-value ( random-float 100 > (tardy-rate + tardy-rate * (1 - satisfaction))) [ false ] [ true ] )
end

;; ====== VARIOUS REPORTERS


; This reporter generates outputs (usually at end of run or from BehaviorSpace) for the average employees
to-report final-average-employee-stats-for-company [ .c ]
  
  let _output []
  ask [ my-average-employees] of .c [
    set _output lput ( list "EPIs: " ) _output ; for " (word my-company-name " (" count tracked-colleagues " emps)" ) ) _output
    set _output lput ( list "total-earnings" mean [ total-earnings ] of tracked-colleagues ) _output
    set _output lput ( list "total-hours-scheduled" mean [ total-hours-scheduled ] of tracked-colleagues ) _output
    set _output lput ( list "total-hours-worked" mean [ total-hours-worked ] of tracked-colleagues ) _output
    set _output lput ( list "total-idle-time" mean [ total-idle-time ] of tracked-colleagues ) _output
    set _output lput ( list "total-misc-task-time" mean [ total-misc-task-time ] of tracked-colleagues ) _output
    set _output lput ( list "total-productivity" mean [ total-productivity ] of tracked-colleagues ) _output
    set _output lput ( list "total-rest-time" mean [ total-rest-time ] of tracked-colleagues ) _output
    set _output lput ( list "total-revenues" mean [ total-revenues ] of tracked-colleagues ) _output
    set _output lput ( list "total-tardy-time" mean [ total-tardy-time ] of tracked-colleagues ) _output
    set _output lput ( list "total-sales-closed" mean [ total-sales-closed ] of tracked-colleagues ) _output
  ]
  
  report _output
end

;; ----- merged from Includes/EVENTS.nls -----
;; ------ EVENTS.nls -------
;; 
;; Functions related to our home-grown event scheduler


;; Schedule an event for myself
to schedule-my-event [ .type .time ]
  
  ; Add myself to the set of agents with an event at this particular time
  let _active table:get $#es-daily-events .time ; Fetch the current list of agents with an activity at this time
  
  ; Check to make sure this agent is not being double-booked!
  ifelse ( _active != nobody and member? self _active ) [
    dprint -1 "schedule-my-event" (word "XXX PROBLEM: " who-when 
      " already has activity " my-next-activity " scheduled for time " ( clock-time .time ) )
  ]
  [
    table:put $#es-daily-events .time (turtle-set self _active) ; Add yourself to the list of agents with an event scheduled at this time.
    
    ; PG debug - this can be useful if we want to trace every scheduled event for a particular day/time set by $trace-day
;    if ( ticks = $trace-day and $es-daily-time mod 1 = 0 ) [    
;      print (word who-when "Just scheduled event of type " .type " for " clock-time .time)
;    ]
    
    ; If no other events are already scheduled for that time, add that time to the list
    if not member? .time $es-events-list [ set $es-events-list lput .time $es-events-list ]
    
    ; Add the activity to your own activity table - uncomment if you need to track the event scheduler.
    ; table:put #daily-events calendar-time $es-daily-time (word self "scheduled a task of type " .type " to happen at " clock-time .time )
    
    set my-next-activity .type
  ]

end


;; ----- merged from Includes/GENERAL.nls -----
;; ============== GENERAL PROCEDURES AND REPORTERS

; Check bounds of a variable. If it exceeds min or max, it returns the bounds.
to-report check-bounds [ var low high ]
  report (ifelse-value
    var < low [ low ]
    var > high [ high ]
    [ var ]
    )
end

; Check bounds of a tracked variable. If it exceeds min or max, it returns the bounds.
to-report check-bounds-e [ .var .varname ]
  let _min table:get ( table:get $#tracked-vars .varname ) "min"
  let _max table:get ( table:get $#tracked-vars .varname ) "max"

  report (ifelse-value
    .var < _min [ _min ]
    .var > _max [ _max ]
    [ .var ]
    )
end

; This simple reporter checks if the item is a string containing a variable name, in which case it returns the value of the variable
to-report get-value [ .item ]
  ifelse is-string? .item 
  [ report runresult .item
  ]
  [ report .item ]  
end


; Convert a single character into a unit
to-report formatted-unit [ .str ]
  ; if it's Netlogo time, return the corresponding string
  ; If it's X return a blank
  ; Evertying else, leave untouched
    report (ifelse-value
    .str = "s" [ "seconds"]
    .str = "m" [ "minutes"]
    .str = "h" [ "hours"]
    .str = "d" [ "days"]
    .str = "w" [ "weeks"]
    .str = "M" [ "months"]
    .str = "y" [ "years"]
    .str = "X" [ "" ]
    [ .str ]
  )

end


;; Convert a number of minutes into a string in the format HH:mm (24-hour clock)
to-report time-of-day [ .min ]
  let _hrs floor ( .min / 60 )
  let _hrspad ifelse-value ( _hrs < 10 ) [ "0" ] [ "" ]
  let _mins remainder .min 60
  let _minpad ifelse-value ( _mins < 10 ) [ "0" ] [ "" ]

  report (word _hrspad _hrs ":" _minpad _mins )
end


;; Report a clock time string using the pre-loaded array
to-report clock-time [ .min ]
;  if ( .min < 0 or .min >= length $es-clock-time ) [
;    dprint 0 "clock-time" (word who-when "is asking to convert an invalid time (" .min ")" )
;  ]
  report array:item $es-clock-time .min
end


;; Report a complete date string
to-report calendar-time [ .min ]
;  if ( .min < 0 or .min >= length $es-clock-time ) [
;    dprint 0 "clock-time" (word who-when "is asking to convert an invalid time (" .min ")" )
;  ]
  report (word "Day " ticks " @" array:item $es-clock-time .min)
end



;; Convert a string in the format HH:mm (24-hour clock) into a number of minutes from 0:00
to-report minutes-of-day [ .time ]
  let _tlist string-to-list-of-strings .time ":"
  let _hrs read-from-string item 0 _tlist
  let _min read-from-string item 1 _tlist

  report ( $es-ticks-per-hour * _hrs + _min )
end


; ----------- LIST and TABLE operations

;; Create a list with a number of items given by .nitems and initialize it with 0s
