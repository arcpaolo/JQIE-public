;; ----- merged from Includes/NLWEB-PARAMS.nls -----
;; NLWEB-PARAMS.nls
;; This file is used only for the NetLogoWeb version and will be merged in by the script.
;; NOTE: THIS FILE SHOULD NOT BE LISTED AS AN INCLUDE[] IN THE MAIN (NON-WEB) NetLogo FILE!

; There are two version of this function: this version is NOT listed as an Incluude[] in the main .nlogo file, but it gets included when merging files for netlogoweb. The other version, which is listed as an Include[] but appears in a subfolder, is called PARSE-CSV.nls and it reads parameters from a series of csv files.

; This version always reads from pre-loaded params
to initialize-from-source [ .type ]
  initialize-from-list .type
end

; Read in parameters from a string based on parameters set in PARAMS.nls (should only happen if running in netlogoweb
to initialize-from-list [ .type ]

   ; Read in the correct list
  (ifelse
    .type = "companies" [ set $param-source $companies-params ]
    .type = "displays" [ set $param-source $displays-params ]
    .type = "employees" [ set $param-source $employees-params ]
    .type = "tasks" [ set $param-source $tasks-params ]
    .type = "tracked-vars" [ set $param-source $tracked-vars-params ]
  [ dprint -1 "initialize-from-list" (word "cannot find the list of parameters for type \"" .type "\"" ) ]
  )
  let _num-lines length $param-source; How many lines should be in the list

  let _fields csv:from-row item 0 $param-source ; Read in the header with the field names
  let _formats csv:from-row item 1 $param-source ; Read in the field formats
  ; Check to make sure we have the right number of fields
  ifelse length _fields != length _formats [
    dprint -1 "initialize-from-list" (word "Different numbers of fields (" _fields ") and formats (" _formats ") found in " $param-source )
  ]
  [
    set $num-parsed-params length _fields - 1 ; The number of parameters is 1 less than the number of fields (the first column is industry)
  ]
  
  ; Here we create a list of the formats for each parameter
  set _fields but-first ( _fields ) ; Remove the first item (industry)
  set _formats but-first ( _formats ) ; Remove the first item (industry)
  set $par-formats []
  (foreach _fields _formats [ [ fld fmt ] -> set $par-formats lput (list fld fmt) $par-formats ] )
  dprint 3 "initialize-from-list" (word "The parameter formats for $" .type "-fname are: " $par-formats)
    
  ; Now read in all the tasks and their parameters
  let _line 2 ; Start with the third line (item 2) from the list
  while [ _line < _num-lines ] [
    let _row item _line $param-source
    init-parameters-from-csv .type csv:from-row _row
    set _line _line + 1
  ]
  
  ifelse $num-parsed-params = 0 [
    dmsg -1 "initialize-from-list" (word "Could not find any " .type " parameters in " $param-source )
    stop
  ]
  [
    dprint 3 "initialize-from-list" (word "Found " $num-parsed-params " " .type " parameters in $" .type "-fname. List length was " _num-lines " (check: " ( _line - 1 ) " processed)" )
  ]
  
end


; This is a dummy version that will not cause compilation problems in NetLogoWeb
to initialize-from-file [ .type ]
  dprint -1 "initialize-from-file" (word "This is being invoked in the NetLogoWeb version - should not be happening!!!" )
end
