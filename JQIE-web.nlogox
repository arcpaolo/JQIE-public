;; ----- merged from Includes/SPRITES.nls -----
;======== SPRITES ============
; Function to create a sprite for an agent
to make-my-sprite
  hatch-sprites 1 [
    set hidden? ifelse-value ($sprites?) [ false ] [ true ]
    set my-parent myself ; Note that "myself" is a primitive that returns the agent (turtle/link/patch) that created or ask'd me
    ask myself [ set my-sprite myself ] ; Ask the turtle that created you to make you their sprite. Note that here the second myself is the sprite...
    set shape "bar"
    set size ( [ size ] of my-parent / 1.5 )
    ; Note: the following fetches the min and max values of the variable being tracked. It only needs to happen here or if $sprite-var changes
;    set col-min item $ev-min ( table:get $#e-vars $sprite-var )
;    set col-max item $ev-max ( table:get $#e-vars $sprite-var )
  ]
end


;; Update the position and color of sprite
to update-sprite [ .sprite ]
  if hidden? [ stop ] ; No need to update anything if hidden.
  
  ; Note that here we are still invoked by the employee, so these vars refer to the employee, not the sprite
  let _x xcor
  let _y ycor
 
  ask .sprite [ 
    ; Update the position
    setxy _x ( _y + [ size ] of my-parent) ; Let's drag our sprite along above our head.
    ; Update the color - this command uses a dynamic color range 
;    set p-var table:get ( [ #e-vars ] of my-parent ) $sprite-var
    set color palette:scale-scheme "Divergent" "RdYlGn" 11 p-var col-min col-max
  ]
    
end

;; ----- merged from Includes/TASKS.nls -----
;; -------------- TASKS.nsl --------------

;; This include file contains all the procedures related to task agents.


;; Initial setup of the tasks
to setup-tasks
  
  ; Initialize the tasks for each company from a parameter variable defined in PARAMS.nls
  initialize-from-source "tasks"
  
  ; Initialize the $#company-tasks table to empty lists
  foreach table:keys $#tasks [ key ->
    let _task table:get $#tasks key
    let _company table:get _task "company" ; The name of the company
    let _role table:get _task "role" ; The name of the company
    let _class (word _company "+" _role ) ; This is needed to identify/assign tasks

    table:put $#company-tasks _class []
  ]

  ; Do a quick sanity check to make sure the various tables are in order
  sanity-check-inputs
  
end


;; General task assignment handler
; This is invoked by each company agent. The parameter passed in specifies the task type
to task-arrives [ .task ]
  
;  if ( ticks = 69 and ( who = 3 ) and member? ( clock-time $es-daily-time ) [ "08:27" "08:57" "09:27" "09:33" "09:37" "09:41" "09:53" "10:25" "10:30" "10:34" "11:07" "11:29" "11:52" "12:03" "12:21" "12:31" "12:43" "12:44" "12:48" "13:34" "13:45" "13:46" "14:10" "14:12" "14:23" "14:33" "14:38" "14:49" "14:52" "15:17" "15:21" "15:24" "15:25" "15:28" "15:29" "15:43" "15:51" "16:19" "17:20" ]) 
;  [
;    print (word who-when "just invoked task-arrives with task " .task )
;  ]

;  let _#task table:get $#tasks .type ; Retrieve the task description  
  create-task-agent .task ; Assign this task to a task agent
  let _type table:get .task "type"
  
  let _next-time ( $es-daily-time + task-gap .task )
  ifelse ( _next-time > EOB ) [ ; If it is a working-hours task (such as a customer arriving), then see if it should be bounced to tomorrow.
    dprint 2 "task-arrives" (word who-when "tried to create a " _type " task after end of business - this task will be ignored, all done for today.")
  ]
  [
    schedule-my-event [ -> task-arrives .task ] _next-time
    dprint 4 "task-arrives" (word who-when _type " task created! Next one at " clock-time _next-time )
  ]
end


; Create a task agent to track a task - this is invoked by a company agent
to create-task-agent [ .#task ]
  
  ; Now grab the task parameters to create and initialize the task
  let _type table:get .#task "type" ; The type of task, e.g., "customer"
  let _role table:get .#task "role" ; The role of who can do this task
  let _company table:get .#task "company" ; The name of the company
  let _class (word _company "+" _role ) ; This is needed to identify/assign tasks

  ; Check if there are too many tasks of this type
  ; Each time we assign a task we decrement the counter and stop if we hit zero. It gets incremented went task agent dies (task expires)
  ; This way, we can ensure that only a certain number of simultaneous versions of the same task can occur.
  let _num-assigned table:get .#task "max-num" ; See how many tasks of this type are available for assignment
  if _num-assigned < 1 [ 
    dprint 0 "create-task-agent" (word who-when "tried to assign a new " _type " task, but already have enough tasks of this type. Skipping")
    stop ] 

  ; Check how long this task will take and skip it if effort will take you past EOB
  let _effort round runresult ( item 0 table:get .#task "effort" )
  if ( $es-daily-time + _effort >= EOB ) [
    ; If the effort takes you only a bit beyond EOB, change the effort to match closing time, else cancel it
    ; Note the 0.1 in the denominator is to avoid this blowing up if $es-daily-time = EOB
    ifelse ( _effort / ( 0.1 + EOB - $es-daily-time ) ) < 1.5 ; 1.5 would mean that the effort is about 33% more than the time left
    [
      let _msg (word who-when "tried to assign a new " _type " task with effort=" _effort ". Changed it to " )
      set _effort ( EOB - $es-daily-time - 1 ) ; Make the task end one minute before EOB 
      dprint 2 "create-task-agent" (word _msg _effort ".")
    ]
    [
      dprint 2 "assign-task" (word who-when "tried to assign a new " _type " task with effort=" _effort ", but that would go past EOB. Skipping." )
      stop
    ]
  ]
  ;let _exp-time runresult table:get .#task "expiration"
;  let _value table:get .#task "value" ; Get the value
  let _#tq-row table:make
  
  let _agent ""
  let _my-EOB EOB
  
  ; Create a task agent
  hatch-tasks 1 [
    set hidden? true
    set created-time calendar-time $es-daily-time
    set #daily-events table:make ; Need to set this up as a blank table
    set daily-activities [] ; And this as a blank list
    ; Let the agent set itself up with all the information from the task
    set my-company myself
    set _agent who ; Need this so the company knows the ID of the task agent
    set expiration-time round runresult ( item 0 table:get .#task "expiration" )
    ; Now add the expiration period to the current time
    set expiration-time expiration-time + $es-daily-time
    if ( expiration-time > _my-EOB ) [ set expiration-time _my-EOB ] ; If it's past the end of business, set it to expire at the end of business.
    set my-value round runresult table:get .#task "value"
    set prob-success table:get .#task "prob-success"
    set my-role _class
    set my-type (word _company "+" _type)
    set started? false
    set completed? false

;    dprint 3 "create-task" (word "The counter for task type " _type " is " ( table:get .#task "max-num" ) )
    table-item-- .#task "max-num" ; Reduce the number of remaining tasks of this type
;    dprint 3 "create-task" (word "The counter for task type " _type " has been decremented to " ( table:get .#task "max-num" ) )

    
    ; Now schedule the expiration of this task
    schedule-my-event [ -> check-task-expiration _class ] expiration-time ;
    add-to-store-schedule _class _effort _type
    
    add-activity (word my-company "added me (act " who ") to the store schedule. Set to expire at " clock-time expiration-time )
    
    dprint 4 "assign-task" (word who-when "added task #" who " to the queue, expires at " clock-time expiration-time )
    
  ]
  
  set daily-customer-visits daily-customer-visits + 1
  
  add-activity (word "Just created task agent " _agent " to handle a new task of type " _class )
  
end



; Check if task has expired - this is invoked by a task agent
to check-task-expiration [ .class ]
  
  ifelse ( started? )
  [ ; Looks like an employee picked this task before it expired! Yay! Trust the employee to tell me when they are done.
    add-activity (word "Employee " my-employee " " my-company " has picked up this task, and is supposed to finish it at " clock-time completion-time )
    ; Let the company know that some employee started you!
    ask my-company [ set daily-customers-helped daily-customers-helped + 1 ]

  ]
  [ ; If we have not been started, we need to complete the task ourselves
    let _current-task-list (table:get $#company-tasks .class)
    set _current-task-list remove my-task-description _current-task-list
    table:put $#company-tasks .class _current-task-list
    table-item++ ( table:get $#tasks my-type ) "max-num" ; Increase the number of remaining tasks of this type
    
    ; If this is a customer task, even if the customer was not greeted by a sales rep, they may still end up with a purchase
    let _non-emp-revs 0
    if ( member? "customer" my-type ) 
    [      
      ; Industry standard: a customer not helped is only 14% likely to purchase, and transaction will be 55% of average.
      if ( ( random-float 1.0 ) < 0.14 ) 
      [
        set _non-emp-revs round ( my-value * 0.55 )
        ask my-company [ set daily-non-employee-sales-closed daily-non-employee-sales-closed + 1 ] ; Register the additional non-employee sale
        dprint 3 "check-task-expiration" (word "Customer " who " just made a purchase for $" _non-emp-revs )
      ]
    ]
    ask my-company [ 
      set daily-tasks-expired daily-tasks-expired + 1 ; Let the company know a task expired
      set daily-non-employee-revenues daily-non-employee-revenues + _non-emp-revs
    ]
    
  ]
end


;; Complete a task - note that this is invoked by a task agent
to complete-task

  ; Let the company know of the successful completion of the task
;  ask my-company [ 
;    set daily-tasks-completed daily-tasks-completed + 1
;  ]

  table-item++ ( table:get $#tasks my-type ) "max-num" ; Increase the number of remaining tasks of this type
  
end


;; Add a task to the store schedule - later this could be prioritized
to add-to-store-schedule [ .class .effort .type ]
  ; The assumption here is that each employee will look at the list of tasks for its role, and initially decided strictly on whether it has time to do it.
  set my-task-description (list self .class .effort .type )
    
  let _current-task-list (table:get $#company-tasks .class)
     
  set _current-task-list lput my-task-description _current-task-list ; We put the task at the back of the queue. Eventually this could be managed in some other way
  table:put $#company-tasks .class _current-task-list
  set posted? true
  set $daily-tasks-posted $daily-tasks-posted + 1 ; Increment the counter of daily tasks posted.
  
end


; Calculate the gap to the next task of this type
to-report task-gap [ .task ]
  ; Calculate the next time depending on whether the business is open or not
  let _gap round ( runresult item 0 table:get .task "next-time" ); Invoke the anonymous procedure that will calculate the gap to the next task
  if ( _gap < 1 ) [ ; Need to make absolutely sure that the gap is never 0 or negative!
    dprint 2 "task-arrives" (word who-when ">>> GAP=" _gap "->1 for " .task )
    set _gap 1
  ]
  
  if ( _gap > 60 ) [
    dprint 2 "task-arrives" (word who-when "GAP to next task is " _gap )
  ]
  
  report _gap

end

]]></code>
