;to table-item-add [ tt ii nn ]
;  table:put tt ii ( nn + table:get tt ii )
;end
;
to table-item++ [ tt ii ]
  table:put tt ii ( 1 + table:get tt ii )
end

to table-item-- [ tt ii ]
  table:put tt ii ( ( table:get tt ii ) - 1 )
end

to-report copy-table [ orig ]
  let copy table:make
  foreach ( table:keys orig ) [
    [key] -> table:put copy key ( table:get orig key )
  ]
  report copy
end


